# IRS IRIS A2A API Configuration
# Copy this file to .env and fill in your credentials from IRS e-Services

# ============================================================================
# IRS e-Services Credentials
# ============================================================================

# API Client ID from your e-Services application
# Format: String identifier (e.g., "A123A456B789")
IRS_CLIENT_ID=

# IRIS User ID assigned to your account
# Format: dasmith-345870 (username + dash + numbers)
IRS_USER_ID=

# Transmitter Control Code (5 characters, starts with D for production)
# Format: DXXXX or TXXXX for test
IRS_TCC=

# Private Key for JWT signing (PEM format)
# Generate with: openssl genrsa -out private-key.pem 2048
# Upload the corresponding public key as a JWK to your API Client application
IRS_PRIVATE_KEY=

# Key ID matching the JWK uploaded to your API Client application
# This identifies which private key to use for signing
IRS_KEY_ID=

# Test Mode (true = use IRS sandbox, false = production)
IRS_TEST_MODE=false

# ============================================================================
# SSA BSO (Business Services Online) Configuration
# ============================================================================

# BSO Mode (mock = simulated responses, real = production API)
BSO_MODE=mock

# BSO User Credentials (for real mode)
BSO_USER_ID=
BSO_PASSWORD=

# ============================================================================
# Server Configuration
# ============================================================================

# Server port (default: 3001)
PORT=3001

# Node environment
NODE_ENV=development
