  "components": {
    "schemas": {
      "searchClientOfferAPI": {
        "required": [
          "searchRequest"
        ],
        "type": "object",
        "description": "",
        "properties": {
          "searchRequest": {
            "$ref": "#/components/schemas/searchRequest"
          }
        },
        "example": {
          "searchRequest": {
            "criteria": [
              {
                "field": "accountNumberOrEbn",
                "operand": "=",
                "value": "89A30051"
              },
              {
                "field": "cusip",
                "operand": "=",
                "value": "007266KS7"
              },
              {
                "field": "offerReferenceNumberFrom",
                "operand": ">=",
                "value": "0"
              },
              {
                "field": "offerReferenceNumberTo",
                "operand": "<=",
                "value": "100"
              },
              {
                "field": "offerCreateTimeFrom",
                "operand": ">=",
                "value": "2023-03-31T05:00:00-04:00"
              },
              {
                "field": "offerCreateTimeTo",
                "operand": "<=",
                "value": "2023-03-31T07:00:00-04:00"
              }
            ]
          }
        }
      },
      "searchRequest": {
        "type": "object",
        "description": "External Offers Search Request",
        "required": [
          "criteria"
        ],
        "properties": {
          "criteria": {
            "type": "array",
            "description": "Array of offer search criteria",
            "items": {
              "$ref": "#/components/schemas/criteria"
            }
          }
        }
      },
      "criteria": {
        "type": "object",
        "properties": {
          "Field": {
            "type": "string",
            "description": "Type of data that is to be sent or received as part of the search request.<br><br>'field': 'accountNumberOrEbn'<br>'description': Your firm\u2019s account number at BofA Securities if you are an Institutional customer. If you are a broker/dealer, it will be your EBN symbol prefixed with \u201cEBN\u201d.<br>If you are a broker/dealer, your operations team will be able to provide you the EBN symbol to use. For (a possibly out of date) list, see DTCC. Ex. Merrill Lynch, Pierce, Fenner & Smith Inc. has MLCO as the symbol and you would provide \u201cEBNMLCO\u201d in the request.<br>'type': 'string'<br><br>'field': 'cusip'<br>'description': CUSIP with or without the 9th check digit<br>'type': 'string'<br><br>'field': 'offerReferenceNumberFrom'<br>'description': Your (BofA Securities generated) Offer  reference number.<br>Only the \u201c>=\u201d operand supported for offerReferenceNumberFrom.<br>'type': 'integer'<br><br>'field': 'offerReferenceNumberTo'<br>'description': Your (BofA Securities generated) Offer  reference number.<br>Only the \u201c<=\u201d operand supported for offerReferenceNumberTo.<br>'type': 'integer'<br><br>'field': 'offerCreateTimeFrom'<br>'description': The time the offer was created by the client to the milliseconds. This would be used to identify the latest offer for a CUSIP. <br>Only the \u201c>=\u201d operand supported for offerCreateTimeFrom.<br>Time expected in \u201cAmerica/New_York\u201d timezone<br>Format -  yyyy-MM-dd'T'HH:mm:ssXXX<br>Example - 2001-07-04T12:08:56-04:00<br>'type': 'string'<br><br>'field': 'offerCreateTimeTo'<br>'description':The time the offer was created by the client to the milliseconds. This would be used to identify the latest offer for a CUSIP. <br>Only the \u201c<=\u201d operand supported for offerCreateTimeTo.<br>Time expected in \u201cAmerica/New_York\u201d timezone<br>Format -  yyyy-MM-dd'T'HH:mm:ssXXX<br>Example - 2001-07-04T12:08:56-04:00<br>'type': 'string'"
          },
          "Value": {
            "type": "string",
            "description": "Value of the data that is to be sent or received as part of the search request."
          },
          "Operand": {
            "type": "string",
            "description": "Object of a mathematical operation.<br>i.e., Equal to \u201c=\u201d, less than or equal to \u201c<=\u201d"
          }
        }
      },
      "searchClientOfferResponseBody": {
        "type": "object",
        "properties": {
          "searchResponse": {
            "type": "array",
            "description": "Array of offers as search response for the given criteria",
            "items": {
              "$ref": "#/components/schemas/searchResponse"
            }
          }
        },
        "example": {
          "searchResponse": [
            {
              "quantity": 50000,
              "settlementDate": "2020-04-23",
              "subjectFirmInd": "FIRM",
              "tradeIncrement": 5000,
              "minimumQuantity": 50000,
              "accruedInterest": 1166.67,
              "offerCreateTime": "2023-03-22T05:36:49.193-04:00",
              "cusip": "007266KS7",
              "price": 113.419,
              "accountNumberOrEbn": "89A30051"
            }
          ]
        }
      },
      "searchResponse": {
        "type": "object",
        "properties": {
          "accountNumberOrEbn": {
            "type": "string",
            "description": "Your firm\u2019s account number at BofA Securities if you are an Institutional customer. If you are a broker/dealer, it will be your EBN symbol prefixed with \u201cEBN\u201d.<br>If you are a broker/dealer, your operations team will be able to provide you the EBN symbol to use. For (a possibly out of date) list, see DTCC. Ex. Merrill Lynch, Pierce, Fenner & Smith Inc. has MLCO as the symbol and you would provide \u201cEBNMLCO\u201d in the request."
          },
          "quantity": {
            "type": "integer",
            "description": "Transaction quantity.<br>In 1000s. If 50 bonds are required, 50000 should be specified. In words that number is \u201cfifty thousand\u201d."
          },
          "settlementDate": {
            "type": "string",
            "description": "Date when the transaction must settle on Expected format YYYY-MM-DD. All numbers."
          },
          "subjectFirmInd": {
            "type": "string",
            "description": "Indicates the type of offer \u2018FIRM\u2019 \u2013 firm price that can be executed electronically \u2018SUBJ\u2019 \u2013 price subject to negotiation, no electronic execution."
          },
          "tradeIncrement": {
            "type": "integer",
            "description": "The Multiples in which trade quantity will be allowed. <br>Ex, if this value is 5000, trade quantity can be 5000,10000,15000 and so on."
          },
          "minimumQuantity": {
            "type": "integer",
            "description": "The minimum trade quantity that the customer would allow."
          },
          "accruedInterest": {
            "type": "number",
            "description": "Accrued Interest to settlement date."
          },
          "offerCreateTime": {
            "type": "string",
            "description": "The time the offer was created by the client to the milliseconds. This would be used to identify the latest offer for a CUSIP.<br>Time expected in \u201cAmerica/New_York\u201d Timezone<br>Format - yyyy-MM-dd'T'HH:mm:ss.SSSXXX<br>Example - 2001-07-04T12:08:56.235-04:00"
          },
          "cusip": {
            "type": "string",
            "description": "CUSIP with or without the 9th check digit"
          },
          "price": {
            "type": "number",
            "description": "The Offer price entered by the customer"
          }
        }
      },
