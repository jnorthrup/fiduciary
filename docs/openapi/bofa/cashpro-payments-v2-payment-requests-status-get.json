        "properties": {
          "transactionIdentification": {
            "type": "string",
            "description": "Bank assigned identifier for the payment at the transaction level"
          },
          "endToEndIdentification": {
            "type": "string",
            "description": "Unique identification assigned by the initiating party to unambiguously identify the transaction. This identification is passed on, unchanged,  throughout the entire end-to-end chain. Length : 1 - 35"
          },
          "status": {
            "type": "string",
            "description": "Status of the transaction <br>Pending<br>Received<br>Accepted<br>Rejected"
          },
          "reason": {
            "type": "array",
            "description": "List of errors for given payment",
            "items": {
              "$ref": "#/components/schemas/reason"
            }
          }
        },
        "example": {
          "transactionIdentification": "CPSe0f8d-04af-48c9-90bc-478e2d9ed8ba",
          "endToEndIdentification": "ReferenceEndToEndId001",
          "status": "PDNG"
        }
