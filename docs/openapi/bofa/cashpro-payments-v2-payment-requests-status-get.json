  "paths": {
    "/cashpro/payments/v2/payment-requests/status": {
      "get": {
        "tags": [
          "Payments V2 Request Status API"
        ],
        "summary": "Returns the status of your payment request.",
        "operationId": "globalDigitalDisbursementsStatuses",
        "parameters": [
          {
            "name": "Authorization",
            "in": "header",
            "description": "A unique access token to be used for a single reporting request. </br>ex. Bearer XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX. </br>Token that client receives after calling the Auth service. ",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "TransactionIdentification",
            "in": "header",
            "description": "Bank assigned identifier for the payment at the transaction level<br>Length: 1-36",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Request received successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/statusesResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StatusError400"
                }
              }
            }
          },
          "401": {
            "description": "Authentication Failure",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StatusError401"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StatusError403"
                }
              }
            }
          },
          "404": {
            "description": "Resource Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StatusError404"
                }
              }
            }
          },
          "405": {
            "description": "Method Not Allowed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StatusError405"
                }
              }
            }
          },
          "406": {
            "description": "Not Acceptable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StatusError406"
                }
              }
            }
          },
          "408": {
            "description": "HTTP Timeout Exception",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StatusError408"
                }
              }
            }
          },
          "415": {
            "description": "Unsupported Media Type",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StatusError415"
                }
              }
            }
          },
          "429": {
            "description": "API calls exceeded",
            "content": {}
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StatusError500"
                }
              }
