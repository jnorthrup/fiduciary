  "components": {
    "schemas": {
      "ZelleRequestBody": {
        "type": "object",
        "required": [
          "selectionCriteria"
        ],
        "properties": {
          "selectionCriteria": {
            "type": "object",
            "required": [
              "identifier"
            ],
            "description": "Selection criteria with parameters such as alias identifier, contact point to retrieve alias token status along with other attributes",
            "properties": {
              "identifier": {
                "type": "object",
                "required": [
                  "type",
                  "value"
                ],
                "properties": {
                  "type": {
                    "type": "string",
                    "description": "Type of the alias token"
                  },
                  "value": {
                    "type": "string",
                    "description": "email/mobile value"
                  }
                }
              }
            }
          },
          "rules": {
            "type": "object",
            "required": [
              "enrichmentRules"
            ],
            "description": "A set of rules intended to be used for routing, handling, and processing of the service request",
            "properties": {
              "enrichmentRules": {
                "type": "array",
                "description": "Identifies what objects need to be included, more like a inclusion list<br>",
                "items": {
                  "$ref": "#/components/schemas/enrichmentRulesObject"
                }
              }
            }
          }
        },
        "example": {
          "selectionCriteria": {
            "identifier": {
              "type": "mobile",
              "value": "7325899700"
            }
          },
          "rules": {
            "enrichmentRules": [
              {
                "name": "includeassociatedfinancialinstitution",
                "value": "true"
              }
            ]
          }
        }
      },
      "enrichmentRulesObject": {
        "type": "object",
        "required": [
          "type",
          "value"
        ],
        "properties": {
          "type": {
            "type": "string",
            "description": "Rule type which indicates whether the associated financial institution details need to be returned in the response for an Alias Token"
          },
          "value": {
            "type": "string",
            "description": "Rule value which indicates whether the associated financial institution details need to be returned in the response for an Alias Token"
          }
        }
      },
      "zelleTokenStatusResponse200": {
        "type": "object",
        "properties": {
          "requestId": {
            "type": "string",
            "description": "Unique Identifier"
          },
          "status": {
            "type": "string",
            "description": "SUCCESS/FAILED"
          },
          "aliasTokenIdentifier": {
            "type": "object",
            "description": "Zelle Token Type Identifier",
            "properties": {
              "type": {
                "type": "string",
                "description": "Zelle token type - mobile/email"
              },
              "value": {
                "type": "string",
                "description": "Zelle token value"
              }
            }
          },
          "aliasTokenStatus": {
            "type": "object",
            "description": "Profile/Token Status<br>Enrolled - Registered in Zelle and available to send/receive transactions<br>UnEnrolled - Either not yet registered in Zelle, or registered earlier and currently unregistered<br>OptedOut - Token is opted out from receiving any notifications. Token is not allowed to register or receive transactions<br>Restricted - Token is blocked in EWS. This token cannot send/receive transactions",
            "properties": {
              "value": {
                "type": "string",
                "description": "Valid values are enrolled / unenrolled / optedout / restricted"
              }
            }
          },
          "customerName": {
            "type": "object",
            "description": "Name of the customer",
            "properties": {
              "displayName": {
                "type": "string",
                "description": "Name of the Business"
              },
              "firstName": {
                "type": "string",
                "description": "First name of a person"
              }
            }
          },
          "aliasTokenClassificationType": {
            "type": "string",
            "description": "Classifies whether the alias token is of business or personal"
          },
          "aliasTokenAssociatedFinancialInstitution": {
            "type": "object",
            "description": "Identifies the financial institution at which the alias token is registered by a customer. For example, a customer may register an email address at Bank of America, then the financial institution corresponding to the alias token will be Bank of America",
            "properties": {
              "financialInstitutionCode": {
                "type": "object",
                "description": "Used to identify financial institutions code and value",
                "properties": {
                  "code": {
                    "type": "string",
                    "description": "Identifies the financial institution at which the alias token is registered by a customer. For example, a customer may register an email address at Bank of America, then the financial institution corresponding to the alias token will be Bank of America"
                  },
                  "value": {
                    "type": "string",
                    "description": "Name of the financial institution at which the alias token is registered by a customer"
                  }
                }
              }
            }
          }
        },
        "example": {
          "requestId": "2febfb9c-db44-49b1-b3a5-02e2001b167e",
          "status": "SUCCESS",
          "aliasTokenIdentifier": {
            "type": "mobile,",
            "value": "7325899700,"
          },
          "aliasTokenStatus": {
            "value": "inactive"
          },
          "customerName": {
            "displayName": "Jun19TestRec02",
            "firstName": "Jun19TestRec02"
          },
          "aliasTokenClassificationType": "person",
          "aliasTokenAssociatedFinancialInstitution": {
            "financialInstitutionCode": {
              "code": "PNC",
              "value": "PNC Bank, National Association"
            }
          }
        }
      },
