            "example": "RFIsample00001"
          },
          "rfiText": {
            "type": "string",
            "description": "Request for information response details. Length: 1 - 140 ",
            "example": "This transaction was submitted for invoice ABC12345."
          }
        }
      },
      "rfiResponse": {
        "type": "object",
        "properties": {
          "transactionIdentification": {
            "type": "string",
