  "paths": {
    "/cashpro/payments/v2/payment-RRFI": {
      "post": {
        "tags": [
          "Payments V2 API"
        ],
        "summary": "Responds to a US RTP Request for Information message.",
        "operationId": "intents",
        "parameters": [
          {
            "name": "Content-Type",
            "in": "header",
            "description": "Identifying the content of the payload as JSON. </br> ex. application/json",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "Authorization",
            "in": "header",
            "description": "A unique access token to be used for a single request. </br> ex. Bearer XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "X-Idempotency-Key",
            "in": "header",
            "description": "A unique identifier to be used for a single payment. Length: 1 - 256 </br> ex. ABC123",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "TransactionIdentification",
            "in": "header",
            "description": "Bank assigned identifier for the payment at the transaction level<br>Length: 1-36 ",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "description": "RRFI API Request Body",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/rfiRequest"
              }
            }
          },
