        }
      }
    }
  },
  "components": {
    "schemas": {
      "cancellationsResponse": {
        "required": [
          "transactionIdentification",
          "paymentStatus",
          "endToEndIdentification"
        ],
        "type": "object",
        "properties": {
          "transactionIdentification": {
            "type": "string",
            "description": "Unique transaction identifier as assigned by the bank",
            "example": "1234567890ABC"
          },
          "endToEndIdentification": {
            "type": "string",
            "description": "Client assigned end to end identifier of the transaction",
            "example": "SenderRefSIT18"
          },
          "paymentStatus": {
            "type": "string",
            "description": "Status of the transaction </br>Cancelled</br> Or current state of payment ",
            "example": "Cancelled"
          }
        }
      },
      "cancellationsErrorResponse": {
        "required": [
          "transactionIdentification",
          "paymentStatus",
          "endToEndIdentification"
        ],
        "type": "object",
        "properties": {
          "transactionIdentification": {
            "type": "string",
            "description": "Unique transaction identifier as assigned by the bank. Length: 1-36"
          },
          "paymentStatus": {
            "type": "string",
            "description": "Status of the transaction:<br> &#149; Processing by Bank<br> &#149; Rejected by Bank<br> &#149; Settlement Complete <br> &#149; Approved <br> &#149; Cancelled <br> &#149; Received by Bank <br> &#149; Pending Bene Verification <br>  &#149; Confirmed by Bank"
          },
          "endToEndIdentification": {
            "type": "string",
            "description": "Unique identification assigned by the initiating party to unambiguously identify the transaction. This identification is passed on, unchanged, throughout the entire end-to-end chain. Length : 1-16"
          },
          "reason": {
            "type": "array",
            "description": "List of errors for given payment",
            "items": {
              "$ref": "#/components/schemas/reason"
            }
          }
        },
        "example": {
          "transactionIdentification": " A0JALX03YQTC6NII",
          "paymentStatus": "Cancelled",
          "endToEndIdentification": "ZELLDEC1234",
          "reason": [
            {
              "reasonCode": "CP700",
              "reasonDescription": "Invalid Transaction status for cancel"
            }
          ]
        }
      },
      "reason": {
        "type": "object",
        "properties": {
          "reasonCode": {
            "type": "string",
            "description": "Error reason code. Length: 1-5"
          },
