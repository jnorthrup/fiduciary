        "fileName": "cashpro-payments-v2-payment-initiations-cancellation-post-overview.json"
      },
      "webhook": {
        "enable": false,
        "allowGET": false,
        "allowURI": true,
        "allowQS": true
      }
    }
  },
  "paths": {
    "/cashpro/payments/v2/payment-initiations/cancellation": {
      "post": {
        "tags": [
          "Payments V2 API"
        ],
        "summary": "Deletes a PayPal payment prior to final settlement.",
        "operationId": "globalDigitalDisbursementsCancellations",
        "parameters": [
          {
            "name": "Authorization",
            "in": "header",
            "description": "A unique access token to be used for a single reporting request. </br>ex. Bearer XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX. </br>Token that client receives after calling the Auth service. ",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "TransactionIdentification",
            "in": "header",
            "description": "Bank assigned identifier for the payment at the transaction level<br>Length: 1-36",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Cancelled request processed successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/cancellationsResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/cancellationsErrorResponse"
                }
              }
            }
          },
