{
  "openapi": "3.0.1",
  "info": {
    "title": "Payments V2 Cancellation",
    "description": "Payment Cancellation enables submission of a request to delete/cancel a payment transaction prior to final settlement.",
    "termsOfService": "",
    "license": {
      "name": "Apache 2.0",
      "url": "http://www.apache.org/licenses/LICENSE-2.0.html"
    },
