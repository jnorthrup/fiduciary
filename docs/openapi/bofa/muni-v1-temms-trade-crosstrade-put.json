  "components": {
    "schemas": {
      "requestBody": {
        "required": [
          "orderRequest"
        ],
        "type": "object",
        "properties": {
          "orderRequest": {
            "$ref": "#/components/schemas/requestBodyDetail"
          }
        },
        "example": {
          "orderRequest": {
            "fromAccountNumber": "11111111",
            "settlementDate": "2020-03-27",
            "cusip": "00037NJS6",
            "crossTrades": [
              {
                "toAccountNumber": "22222222",
                "quantityDollarAmount": 100000
              }
            ]
          }
        }
      },
      "requestBodyDetail": {
        "type": "object",
        "description": "Request object",
        "required": [
          "fromAccountNumber",
          "settlementDate",
          "toAccountNumber",
          "quantityDollarAmount",
          "cusip",
          "crossTrades"
        ],
        "properties": {
          "fromAccountNumber": {
            "type": "string",
            "description": "Your account number at BofA Securities that you are moving the securities <b>from</b>"
          },
          "settlementDate": {
            "type": "string",
            "description": "Date when the security move must settle on Expected format YYYY-MM-DD. All numbers"
          },
          "cusip": {
            "type": "string",
            "description": "CUSIP with or without the 9th check digit"
          },
          "crossTrades": {
            "type": "array",
            "description": "Array of cross trades",
            "items": {
              "$ref": "#/components/schemas/crossTradesDetails"
            }
          }
        }
      },
      "crossTradesDetails": {
        "type": "object",
        "required": [
          "toAccountNumber",
          "quantityDollarAmount"
        ],
        "properties": {
          "toAccountNumber": {
            "type": "string",
            "description": "Your account number at BofA Securities that you are moving the securities <b>to</b>"
          },
          "quantityDollarAmount": {
            "type": "integer",
            "description": "Transaction quantity in US dollars In 1000s. If 50 bonds are required, 50000 should be specified. In words, that number is \u201cfifty thousand\u201d."
          }
        }
      },
      "response": {
        "type": "object",
        "properties": {
          "orderResponse": {
            "$ref": "#/components/schemas/orderResponse"
          }
        },
        "example": {
          "orderResponse": {
            "crossTrades": [
              {
                "settlementDate": "2020-03-27",
                "toAccountNumber": "22222222",
                "referenceNumber": 1938519,
                "cusip": "00037NJS6",
                "fromAccountNumber": "11111111",
                "quantityDollarAmount": 100000
              }
            ],
            "hasError": false,
            "errorMessage": null,
            "errorType": null
          }
        }
      },
      "orderResponse": {
        "type": "object",
        "description": "Order response object",
        "properties": {
          "crossTrades": {
            "type": "array",
            "description": "Array of cross trades",
            "items": {
              "$ref": "#/components/schemas/crossTrades"
            }
          },
          "hasError": {
            "type": "boolean",
            "description": "If there were errors when processing the request True/False"
          },
          "errorMessage": {
            "type": "string",
            "description": "Messages if \u2018hasError\u2019 is True. While every effort will be made to notify and co-ordinate when these error message text change, BofA Securities reserves the right to change the text without notice. May\u00a0have\u00a0a\u00a0&#60;null&#62;\u00a0value"
          },
          "errorType": {
            "type": "string",
            "description": "Future use May\u00a0have\u00a0a\u00a0&#60;null&#62;\u00a0value"
          }
        }
      },
      "crossTrades": {
        "type": "object",
        "properties": {
          "settlementDate": {
            "type": "string",
            "description": "Date when the security move must settle on Expected format YYYY-MM-DD. All numbers."
          },
          "toAccountNumber": {
            "type": "string",
            "description": "Your account number at BofA Securities that you are moving the securities <b>to</b>"
          },
          "referenceNumber": {
            "type": "number",
            "description": "Your (BofA Securities generated) trade reference number"
          },
          "cusip": {
            "type": "string",
            "description": "CUSIP with or without the 9th check digit"
          },
          "fromAccountNumber": {
            "type": "string",
            "description": "Your account number at BofA Securities that you are moving the securities <b>from</b>"
          },
          "quantityDollarAmount": {
            "type": "integer",
            "description": "Transaction quantity in US dollars In 1000s. If 50 bonds are required, 50000 should be specified. In words, that number is \u201cfifty thousand\u201d."
          }
        }
      },
