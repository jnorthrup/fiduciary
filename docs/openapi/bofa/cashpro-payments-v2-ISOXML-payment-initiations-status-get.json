    {
      "name": "Payments V2 Status - ISO XML",
      "description": "CashPro API Payments gives you the flexibility to know the status ofsingle payment instruction that was initiated via  multiple global payment types directly from enterprise or treasury management systems using ISO XML messaging"
    }
  ],
