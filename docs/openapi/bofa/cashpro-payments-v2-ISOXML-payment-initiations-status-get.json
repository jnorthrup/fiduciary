  "paths": {
    "/cashpro/payments/v2/isoxml-transfers/status": {
      "get": {
        "tags": [
          "Payments V2 Status - ISO XML"
        ],
        "summary": "Payment Status allows to know the status of single payment instruction through CashPro Payments.",
        "operationId": "",
        "parameters": [
          {
            "name": "Authorization",
            "in": "header",
            "description": "A unique access token to be used for a single request (ex. 'Bearer [value]')",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "X-Idempotency-Key",
            "in": "header",
            "description": "A unique identifier to be used for a single intent ID. Length: 1 - 256 </br> Eg. 123898733525554444",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "fileId",
            "in": "header",
            "description": "File Identifier for the file to retrieve status of payment.",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
