  "components": {
    "schemas": {
      "ISOXmlResponseBody": {
        "type": "object",
        "properties": {
          "transactionIdentification": {
            "type": "string",
            "description": "Unique Identifier"
          },
          "status": {
            "type": "string",
            "description": "Status of payment"
          },
          "transaction": {
            "type": "array",
            "description": "Array of transaction details",
            "items": {
              "$ref": "#/components/schemas/transactionResponse"
            }
          },
          "reason": {
            "type": "array",
            "description": "Array of Details of the reason itself",
            "items": {
              "$ref": "#/components/schemas/reasonResponse"
            }
          }
        },
        "example": {
          "statusResponse": [
            {
              "transactionIdentification": "FS1APD54L2RZ0MCL",
              "status": "Unsuccessful",
              "transaction": [
                {
                  "tranId": "T0MAPD66OJNMDGDC",
                  "endToEndIdentification": "2L2TLL1J42JK",
                  "status": "Rejected",
                  "reason": [
                    {
                      "reasonCode": "VDT-VAL-007",
                      "reasonDescription": "Value Date cannot be older than 30 days."
                    }
                  ]
                }
              ],
              "reason": [
                {
                  "reasonCode": "CPS-ENT-001",
                  "reasonDescription": "Entitlement SenderID Failed"
                }
              ]
            }
          ]
        }
      },
      "transactionResponse": {
        "type": "object",
        "properties": {
          "tranId": {
            "type": "string",
            "description": "Transaction Id : transaction status API to get the status of the transactions  <br>"
          },
          "endToEndIdentification": {
            "type": "string",
            "description": "End to end Identification : When request sent for File and transaction status API, in response it will return the endToEndIdentification which will be fetched from the payload. (e.g.: <EndToEndId>E2ET2LS221</EndToEndId>)  <br>"
          },
          "status": {
            "type": "string",
            "description": "For file and transaction status API, will be getting file and transaction status. (e.g. Reject, Pending Approval, Unsuccessful, Accepted By Bank and Rejected by Bank along with Settlement Complete.) <br>"
          },
          "reason": {
            "type": "array",
            "description": "Array of Details of the reason itself : For a File status and Transaction status API, will get the reason code with reasonCode and reasonDescription. <br>",
            "items": {
              "$ref": "#/components/schemas/reasonResponse"
            }
          }
        }
      },
      "reasonResponse": {
        "type": "object",
        "properties": {
          "reasonCode": {
            "type": "string",
            "description": "Reason code for the failure  <br>"
          },
          "reasonDescription": {
            "type": "string",
            "description": "Reason description for the failure <br>"
          }
        }
