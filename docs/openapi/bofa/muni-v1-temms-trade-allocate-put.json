      "requestBody": {
        "required": [
          "allocationRequest"
        ],
        "type": "object",
        "properties": {
          "allocationRequest": {
            "$ref": "#/components/schemas/allocationRequest"
          }
        },
        "example": {
          "allocationRequest": {
            "parentTradeId": 193850,
            "trades": [
              {
                "quantityDollarAmount": 100000,
                "accountNumber": "89A03R70"
              },
              {
                "quantityDollarAmount": 100000,
                "accountNumber": "89A30M03"
              }
            ]
          }
        }
      },
      "allocationRequest": {
        "type": "object",
        "description": "Allocation request object",
        "required": [
          "parentTradeId",
          "trades"
        ],
        "properties": {
          "parentTradeId": {
            "type": "integer",
            "description": "Internal ID of the trade to be allocated from"
          },
          "trades": {
            "type": "array",
            "description": "Array of \u201cn\u201d trades to be allocated",
            "items": {
              "$ref": "#/components/schemas/trades"
            }
          }
        }
      },
      "trades": {
        "type": "object",
        "required": [
          "quantityDollarAmount",
          "accountNumber"
        ],
        "properties": {
          "quantityDollarAmount": {
            "type": "integer",
            "description": "Transaction quantity in US dollars"
          },
          "accountNumber": {
            "type": "string",
            "description": "Your account number at BofA Securities that you are allocating the securities to"
          }
        }
      },
      "response": {
        "type": "object",
        "properties": {
          "allocationResponse": {
            "$ref": "#/components/schemas/allocationResponse"
          }
        },
        "example": {
          "allocationResponse": {
            "allocations": [
              {
                "quantityDollarAmount": 200000,
                "accountNumber": "89A03R70",
                "parentTradeId": 1938483,
                "referenceNumber": 193854
              },
              {
                "quantityDollarAmount": 100000,
                "accountNumber": "89A30M03",
                "parentTradeId": 1938483,
                "referenceNumber": 193855
              }
            ],
            "hasError": false,
            "errorMessage": null,
            "errorType": null
          }
        }
      },
      "allocationResponse": {
        "type": "object",
