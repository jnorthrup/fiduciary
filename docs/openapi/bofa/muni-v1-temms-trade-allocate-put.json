            "type": "boolean",
            "description": "If there were errors when processing the request True/False"
          },
          "errorMessage": {
            "type": "string",
            "description": "Messages if \u2018hasError\u2019 is True. While every effort will be made to notify and co-ordinate when these error message text change, BofA Securities reserves the right to change the text without notice.  <br> May have a &#60;null&#62; value"
          },
          "errorType": {
            "type": "string",
            "description": "Future use May have a &#60;null&#62; value"
          }
        }
      },
      "allocations": {
        "type": "object",
        "properties": {
          "quantityDollarAmount": {
            "type": "integer",
            "description": "Transaction quantity in US dollars"
          },
          "accountNumber": {
            "type": "string",
            "description": "The account number at BofA Securities that you are allocating the securities to"
          },
          "parentTradeId": {
            "type": "integer",
            "description": "Internal ID of the trade originally allocated from"
          },
          "referenceNumber": {
            "type": "integer",
            "description": "Your (BofA Securities generated) trade reference number"
          }
