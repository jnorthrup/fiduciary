    "/cashpro/reporting/v1/transaction-inquiries/previous-day": {
      "post": {
        "tags": [
          "transaction inquiries"
        ],
        "summary": "Previous Day inquiries provide the prior business day transaction data back to the full two year client retention.",
        "description": "",
