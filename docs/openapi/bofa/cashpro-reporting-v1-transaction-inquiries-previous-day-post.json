  "components": {
    "schemas": {
      "requestBody": {
        "type": "object",
        "required": [
          "fromDate"
        ],
        "properties": {
          "fromDate": {
            "type": "string",
            "description": "First date of requested transactions in YYYY-MM-DD format",
            "example": "2017-11-21"
          },
          "toDate": {
            "type": "string",
            "description": "Last date of requested transactions in YYYY-MM-DD format. Only a date range up to 60 days is supported in a single call.",
            "example": "2017-11-21"
          },
          "accounts": {
            "type": "array",
            "description": "Accounts requested",
            "xml": {
              "name": "accounts",
              "wrapped": true
            },
            "items": {
              "$ref": "#/components/schemas/accounts"
            }
          }
        }
      },
      "response": {
        "type": "object",
        "required": [
          "accountTransactions"
        ],
        "properties": {
          "accountTransactions": {
            "$ref": "#/components/schemas/txAccount"
          }
        }
      },
      "accounts": {
        "type": "object",
        "required": [
          "accountNumber"
        ],
        "properties": {
          "accountNumber": {
            "type": "string",
            "description": "Account number. Length : 1 - 35",
            "example": "601022222222"
          },
          "bankId": {
            "type": "string",
            "description": "BIC or routing number of the account. Length : 1 - 12",
            "example": "BOFAFRPP"
          }
        }
      },
      "txAccount": {
        "type": "object",
        "description": "Accounts returned with transaction details",
        "required": [
          "accountNumber"
        ],
        "properties": {
          "accountNumber": {
            "type": "string",
            "description": "Account number. Length : 1 - 35",
            "example": "601022222222"
          },
          "bankId": {
            "type": "string",
            "description": "BIC or routing number of the account. Length : 1 - 12",
            "example": "BOFAFRPP"
          },
          "currency": {
            "type": "string",
            "description": "Currency code of the account, as documented by ISO 4217 Codes for the representation of currencies and funds.",
            "example": "EUR"
          },
          "transactions": {
            "type": "array",
            "description": "Transaction details returned",
            "xml": {
              "name": "transactions",
              "wrapped": true
            },
            "items": {
              "$ref": "#/components/schemas/transactions"
            }
          }
        }
      },
      "transactions": {
        "type": "object",
        "required": [
          "asOfDate"
        ],
        "properties": {
          "asOfDate": {
            "type": "string",
            "description": "Date of the transaction reported in YYYY-MM-DD format.",
            "example": "2017-11-21"
          },
          "transactionCode": {
            "type": "string",
            "description": "BAI code of the transaction amount reported. Ex: 010, 015, 143, 145, etc.",
            "example": "400"
          },
          "transactionDescription": {
            "type": "string",
            "description": "A description of the BAI code being reported. </br> Ex: Opening Ledger Balance, Closing Ledger Balance, Item in ACH Deposit Credit, ACH Concentration Credit, etc. Length : 1 - 35",
            "example": "Total Debits"
          },
          "transactionType": {
            "type": "string",
            "description": "Summary or Detail",
            "example": "Summary"
          },
          "amount": {
            "type": "string",
            "description": "Balance amount represented as 999999999999999999.99 Length: 1-21",
            "example": "1.00"
          },
          "creditDebitIndicator": {
            "type": "string",
            "description": "Credit or Debit",
            "example": "Debit"
          },
          "availabilityImmediateAmount": {
            "type": "string",
            "description": "Immediate available amount represented as 99999999999999999.999 Length: 1-21 </br> Usage: US accounts only"
          },
          "availability1DayAmount": {
            "type": "string",
            "description": "One day available amount represented as 99999999999999999.999 Length: 1-21 </br> Usage: US accounts only"
          },
          "availability2PlusDayAmount": {
            "type": "string",
            "description": "Two plus day available amount represented as 99999999999999999.999 Length: 1-21 </br> Usage: US accounts only"
          },
          "itemCount": {
            "type": "string",
            "description": "Count of items contained within the transaction. Length: 1-12",
            "example": "1"
          },
          "valueDate": {
            "type": "string",
            "description": "Value date of the transaction being reported in YYYY-MM-DD format",
            "example": "2017-11-21"
          },
          "customerReference": {
            "type": "string",
            "description": "Customer reference number associated with the transaction. Length: 1-50 ",
            "example": "CUSTREF123"
          },
          "bankReference": {
            "type": "string",
            "description": "Bank reference number associated with the transaction. Length: 1-30",
            "example": "555555555555"
          },
          "detailText": {
            "type": "string",
            "description": "Additional details associated with the transaction. Length: 1-3600",
            "example": "BENEFICIARY UNSTRUCTURED DETAIL TEXT"
          }
        }
      },
