              "type": "string"
            }
          },
          {
            "name": "Authorization",
            "in": "header",
            "description": "A unique access token to be used for a single request (ex. Bearer [value])",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "X-Idempotency-Key",
            "in": "header",
            "description": "A unique identifier to be used for a single intent ID. Length: 1 - 256 </br> Eg. 123898733525554444",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "isPayrollFile",
            "in": "header",
            "description": "If marked as true then will consider the uploaded file as a PAYROLL file. enum: \"True\", \"False\"",
            "required": true,
            "schema": {
              "type": "string",
              "default": "False",
              "enum": [
                "True",
                "False"
