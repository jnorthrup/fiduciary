      "post": {
        "tags": [
          "Payments V2 Initiation - ISO XML"
        ],
        "summary": "Payment Initiations allows for the origination of single payment instruction through CashPro Payments.",
        "parameters": [
          {
            "name": "Content-Type",
            "in": "header",
            "description": "Identify the content of the request Body as Multipart/form-data. Use 'Content-Type: multipart/form-data'. This is the only content type supported as of now. Content-Types cannot be negotiated programmatically at this time. Future versions might provide that facility.",
