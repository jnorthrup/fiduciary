  "components": {
    "schemas": {
      "bidBody": {
        "required": [
          "bidRequest"
        ],
        "type": "object",
        "properties": {
          "bidRequest": {
            "type": "array",
            "description": "",
            "items": {
              "$ref": "#/components/schemas/bidRequest"
            }
          }
        },
        "example": {
          "bidRequest": [
            {
              "accountNumberOrEbn": "123456789",
              "bidByTime": "2020-02-05T21:45:12.000Z",
              "competitive": true,
              "confirmations": [],
              "cusip": "123456789",
              "firmTillTime": "2020-02-05T21:55:12.000Z",
              "quantity": 5000,
              "settlementDate": "2020-02-07",
              "userMemo": ""
            }
          ]
        }
      },
      "bidRequest": {
        "type": "object",
        "required": [
          "accountNumberOrEbn",
          "bidByTime",
          "competitive",
          "confirmations",
          "cusip",
          "firmTillTime",
          "quantity",
          "settlementDate",
          "userMemo"
        ],
        "properties": {
          "accountNumberOrEbn": {
            "type": "string",
            "description": "Your firm\u2019s account number at BofA Securities if you are an Institutional customer. If you are a broker/dealer, it will be your EBN symbol prefixed with \u201cEBN\u201d. If you are a broker/dealer, your operations team will be able to provide you the EBN symbol to use. For (a possibly out of date) list, see DTCC. Ex. Merrill Lynch, Pierce, Fenner & Smith Inc. has MLCO as the symbol and you would provide \u201cEBNMLCO\u201d in the request"
          },
          "bidByTime": {
            "type": "string",
            "format": "DateTime",
            "description": "The earliest time in the business day that a bid request can be submitted.ISO 8601 date time format specifying date and time with HH, MM, SS and without time zone offsets. Time zone is always expected to be US Eastern. See Wikipedia (<a href=\"https://en.wikipedia.org/wiki/ISO_8601\" target=\"_blank\" rel=\"noopener noreferrer\">Link</a>) for ISO 8601. If caller uses Java, it is this (<a href=\"https://commons.apache.org/proper/commons-lang/apidocs/org/apache/commons/lang3/time/DateFormatUtils.html#ISO_8601_EXTENDED_DATE_FORMAT\" target=\"_blank\" rel=\"noopener noreferrer\">Link</a>) for Apache Commons Lang date time format (ISO_8601_EXTENDED_DATE_FORMAT) that provides a reference for the format"
          },
          "competitive": {
            "type": "boolean",
            "description": "Future use"
          },
          "confirmations": {
            "type": "array",
            "description": "Future use",
            "items": {
              "$ref": "#/components/schemas/Confirmation"
            }
          },
          "cusip": {
            "type": "string",
            "description": "CUSIP with or without the 9th check digit"
          },
          "firmTillTime": {
            "type": "string",
            "format": "Date",
            "description": "The latest time the quoted price will be firm after which it becomes subject and cannot be executed electronically. See \u201cAdditional Notes\u201d for <b>bidByTime</b> for format and expectations"
          },
          "quantity": {
            "type": "integer",
            "description": "Transaction quantity of the bid desired (in 1000s). If 50 bonds are required, 50000 should be specified. In words that number is \u201cfifty thousand\u201d"
          },
          "settlementDate": {
            "type": "string",
            "format": "Date",
            "description": "Future use"
          },
          "userMemo": {
            "type": "string",
            "description": "Memo to self for the person submitting the bid request. Optional"
          }
        }
      },
      "BidResponse": {
        "type": "object",
        "properties": {
          "bidResponse": {
            "type": "array",
            "description": "",
            "items": {
              "$ref": "#/components/schemas/bidResponseObject"
            }
          }
        },
        "example": {
          "bidResponse": [
