  "components": {
    "schemas": {
      "temmsTradeAPI": {
        "required": [
          "orderRequest"
        ],
        "type": "object",
        "properties": {
          "orderRequest": {
            "type": "array",
            "description": "Array of orders. Minimum size 1. No cognizable upper bound but limited practically by available inventory",
            "items": {
              "$ref": "#/components/schemas/orderRequestTrade"
            }
          }
        },
        "example": {
          "orderRequest": [
            {
              "accountNumber": "19AZ1234",
              "cusip": "882275AA8",
              "quantityDollarAmount": 100000,
              "transactionType": "BUY",
              "settlementDate": "2020-04-20"
            },
            {
              "accountNumber": "19AZ1234",
              "cusip": "00037NJR8",
              "quantityDollarAmount": 100000,
              "transactionType": "BUY",
              "settlementDate": "2020-04-20"
            }
          ]
        }
      },
      "orderRequestTrade": {
        "type": "object",
        "required": [
          "accountNumber",
          "cusip",
          "quantityDollarAmount",
          "transactionType",
          "settlementDate"
        ],
        "properties": {
          "accountNumber": {
            "type": "string",
            "description": "Your firm\u2019s account number at BofA Securities if you are an Institutional customer"
          },
          "cusip": {
            "type": "string",
            "description": "CUSIP with or without the 9th check digit"
          },
          "quantityDollarAmount": {
            "type": "integer",
            "description": "Transaction quantity in US dollars In 1000s. If 50 bonds are required, 50000 should be specified. In words, that number is \u201cfifty thousand\u201d."
          },
          "transactionType": {
            "type": "string",
            "description": "Side: BUY/SELL Side is from your perspective. You, the customer, are BUYing from or SELLing to BofA Securities"
          },
          "settlementDate": {
            "type": "string",
            "description": "Date when the transaction must settle on Expected format YYYY-MM-DD. All numbers."
          }
        }
      },
      "orderResponseTrade": {
        "type": "object",
        "properties": {
          "orderResponse": {
            "type": "array",
            "description": "Array of responses for each element of the orderResponse. The combination of CUSIP and quantity can be used as a correlate for the request element",
            "items": {
              "$ref": "#/components/schemas/orderResponseTradeDetails"
            }
          }
        },
        "description": "Successful response",
        "example": {
          "orderResponse": [
            {
              "cusip": "882275AA8",
              "settlementDate": "2020-04-20",
              "accountNumber": "19AZ1234",
              "referenceNumber": 0,
              "quantityDollarAmount": 100000,
              "transactionType": "BUY",
              "hasError": true,
              "errorMessage": "No offer found for cusip 882275AA8."
            },
            {
              "cusip": "00037NJR8",
              "settlementDate": "2020-04-20",
              "accountNumber": "19AZ1234",
              "referenceNumber": 1938510,
              "quantityDollarAmount": 100000,
              "transactionType": "BUY",
              "hasError": false
            }
          ]
        }
      },
      "orderResponseTradeDetails": {
        "type": "object",
        "properties": {
          "cusip": {
            "type": "string",
            "description": "CUSIP with or without the 9th check digit"
          },
          "settlementDate": {
            "type": "string",
            "description": "Date when the transaction must settle on Expected format YYYY-MM-DD. All numbers."
          },
          "accountNumber": {
            "type": "string",
            "description": "Your firm\u2019s account number at BofA Securities if you are an Institutional customer"
          },
          "referenceNumber": {
            "type": "number",
            "description": "Your (BofA Securities generated) trade reference number"
          },
          "quantityDollarAmount": {
            "type": "integer",
            "description": "Transaction quantity in US dollars In 1000s. If 50 bonds are required, 50000 should be specified. In words, that number is \u201cfifty thousand\u201d."
          },
          "transactionType": {
            "type": "string",
            "description": "Side: BUY/SELL Side is from your perspective. You, the customer, are BUYing from or SELLing to BofA Securities"
          },
          "hasError": {
            "type": "boolean",
            "description": "If there were errors when processing the request True/False"
          },
          "errorMessage": {
            "type": "string",
            "description": "Messages if \u2018hasError\u2019 is True. While every effort will be made to notify and co-ordinate when these error message text change, BofA Securities reserves the right to change the text without notice. May\u00a0have\u00a0a\u00a0&#60;null&#62;\u00a0value"
          },
          "errorType": {
            "type": "string",
            "description": "Future use. May\u00a0have\u00a0a\u00a0&#60;null&#62;\u00a0value"
          }
        }
      },
