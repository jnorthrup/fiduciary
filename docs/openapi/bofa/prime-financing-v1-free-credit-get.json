  "components": {
    "schemas": {
      "response": {
        "required": [
          "results"
        ],
        "type": "object",
        "properties": {
          "results": {
            "type": "array",
            "description": "JSON array of response of each margin group id[1..N]",
            "items": {
              "$ref": "#/components/schemas/responseDetails"
            }
          }
        },
        "example": {
          "results": [
            {
              "marginGroupId": "ACBD",
              "marginGroupName": "JOHN DOWE PARTNERS LLC",
              "businessDate": "2020-04-14",
              "freeCredits": "31300000.00",
              "reportingCurrency": "USD",
              "longPhysicalValue": "93131427.95",
              "shortPhysicalValue": "119795399.53",
              "longNotionalValue": "59872025.69",
              "shortNotionalValue": "14337230.62",
              "grossMarketValue": "287136083.79",
              "marginExcess": "",
              "cashDeposits": "",
              "cashLoans": "",
              "netCash": "",
              "beneficialOwnerCoper": null
            }
          ]
        }
      },
      "responseDetails": {
        "type": "object",
        "required": [
          "marginGroupId",
          "marginGroupName",
          "businessDate",
          "freeCredits",
          "reportingCurrency",
          "longPhysicalValue",
          "shortPhysicalValue",
          "longNotionalValue",
          "shortNotionalValue",
          "grossMarketValue",
          "beneficialOwnerCoper"
        ],
        "properties": {
          "marginGroupId": {
            "type": "string",
            "description": "BofA ID of margin group"
          },
          "marginGroupName": {
            "type": "string",
            "description": "BofA Name of margin group"
          },
          "businessDate": {
            "type": "string",
            "description": "Date that the data is generated (Trade Date + 1)"
          },
          "freeCredits": {
            "type": "string",
            "description": "Unencumbered Cash balance amount that this margin group has (USD Equivalent)"
          },
          "reportingCurrency": {
            "type": "string",
            "description": "The currency that the free credits balance above is reported in"
          },
          "longPhysicalValue": {
            "type": "string",
            "description": "Total long market value of all physical positions in the margin group"
          },
          "shortPhysicalValue": {
            "type": "string",
            "description": "Total short market value of all physical positions in the margin group"
          },
          "longNotionalValue": {
            "type": "string",
            "description": "Total long notional value of all TRS swap positions in the margin group"
          },
          "shortNotionalValue": {
            "type": "string",
            "description": "Total short notional value of all TRS swap positions in the margin group"
          },
          "grossMarketValue": {
            "type": "string",
            "description": "sum of LMV, SMV, LNV and SNV"
          },
          "beneficialOwnerCoper": {
            "type": "number",
            "description": "A BofA identifier for identifying the fund manager of the margin group"
          },
          "marginExcess": {
            "type": "number",
            "description": "The current excess/deficit balance of this margin group as stated in the margin statement"
          },
          "cashDeposits": {
            "type": "number",
            "description": "Credit cash held in the margin group"
          },
          "cashLoans": {
            "type": "number",
            "description": "Debit cash held in the margin group"
          },
          "SMV": {
            "type": "number",
            "description": "Total short market value of all physical positions in the margin group"
          },
          "netCash": {
            "type": "number",
            "description": "Net cash balance within the margin group (calculation: Credit Cash - Debit Cash - 1.05*SMV)"
          }
        }
      },
