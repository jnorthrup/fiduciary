    {
      "name": "Prime Brokerage",
      "description": "Prime Brokerage APIs"
    }
  ],
  "paths": {
    "/prime/financing/v1/free-credit": {
      "get": {
        "tags": [
          "Prime Brokerage"
        ],
        "summary": "Provides clients a daily summary of their free credit balances at a margin group level. The response includes the components of free credits including credit cash, debit cash, short market value and margin excess.",
        "parameters": [
          {
            "name": "Authorization",
            "in": "header",
            "description": "Bearer Token",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "businessDate",
            "in": "query",
            "description": "Business date the user is requesting. Expected format YYYY-MM-DD. All numbers.",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
