{
  "openapi": "3.0.1",
  "info": {
    "title": "Prime Brokerage Free Credit",
    "description": "Sends daily summary of free credit balances at a margin group level, including credit cash, debit cash, short market value and margin excess.",
    "license": {
      "name": "Apache 2.0",
      "url": "http://www.apache.org/licenses/LICENSE-2.0.html"
    },
