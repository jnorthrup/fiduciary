  "components": {
    "schemas": {
      "requestBody": {
        "type": "object",
        "required": [
          "addSavedSearch",
          "updateSavedSearch",
          "deleteSavedSearch"
        ],
        "properties": {
          "addSavedSearch": {
            "type": "array",
            "description": "Array of saved search to be added",
            "items": {
              "$ref": "#/components/schemas/AddSavedSearch"
            }
          },
          "updateSavedSearch": {
            "type": "array",
            "description": "Array of saved searches to be updated",
            "items": {
              "$ref": "#/components/schemas/UpdateSavedSearch"
            }
          },
          "deleteSavedSearch": {
            "type": "array",
            "description": "String Array of saved searches to be deleted",
            "items": {
              "type": "string"
            }
          }
        },
        "example": {
          "addSavedSearch": [
            {
              "criteria": [
                {
                  "field": "coupon",
                  "operand": "<=",
                  "value": "2"
                }
              ],
              "name": "Coupon1",
              "notification": "true"
            }
          ],
          "updateSavedSearch": [
            {
              "criteria": [
                {
                  "field": "coupon",
                  "operand": "<=",
                  "value": "1"
                }
              ],
              "name": "1cpn",
              "notification": "true"
            }
          ],
          "deleteSavedSearch": [
            "5cpn"
          ]
        }
      },
      "AddSavedSearch": {
        "type": "object",
        "properties": {
          "criteria": {
            "type": "array",
            "description": "Criteria of saved search",
            "items": {
              "$ref": "#/components/schemas/CriteriaAddArray"
            }
          },
          "name": {
            "type": "string",
            "description": "Name of saved search",
            "example": "Coupon1"
          },
          "notification": {
            "type": "boolean",
            "description": "Set true if user needs any offer updates notification matching with saved search criteria. The Email address on file with BofA Securities Mercury\u2122 will receive an email when inventory matches this saved search",
            "example": true
          }
        }
      },
      "CriteriaAddArray": {
        "type": "object",
        "properties": {
          "field": {
            "type": "string",
            "description": "Field represent different offer criteria properties.\nRefer to Offer API for fields",
            "example": "coupon"
          },
          "operand": {
            "type": "string",
            "description": "Valid operand corresponding to field",
            "example": "<="
          },
          "value": {
            "type": "string",
            "description": "Value set for criteria field",
            "example": "2"
          }
        }
      },
      "UpdateSavedSearch": {
        "type": "object",
        "properties": {
          "criteria": {
            "type": "array",
            "description": "Criteria of saved search",
            "items": {
              "$ref": "#/components/schemas/CriteriaUpdateArray"
            }
          },
          "name": {
            "type": "string",
            "description": "Name of saved search",
            "example": "1cpn"
          },
          "notification": {
            "type": "boolean",
            "description": "Set true if user needs any offer updates notification matching with saved search criteria. The Email address on file with BofA Securities Mercury\u2122 will receive an email when inventory matches this saved search",
            "example": true
          }
        }
      },
      "CriteriaUpdateArray": {
        "type": "object",
        "properties": {
          "field": {
            "type": "string",
            "description": "Field represent different offer criteria properties.\nRefer to Offer API for fields",
            "example": "coupon"
          },
          "operand": {
            "type": "string",
            "description": "Valid operand corresponding to field",
            "example": "<="
          },
          "value": {
            "type": "string",
            "description": "Value set for criteria field",
            "example": "1"
          }
        }
      },
