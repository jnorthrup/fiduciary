      "account": {
        "type": "object",
        "required": [
          "accountNumber",
          "bankId"
        ],
        "description": "Account requested",
        "properties": {
          "accountNumber": {
            "type": "string",
            "description": "Account number. Length : 1 - 35"
          },
          "bankId": {
            "type": "string",
            "description": "BIC or routing number of the account. Length : 1 - 12"
          }
        }
      },
      "fundsCheckAPI": {
        "type": "object",
        "required": [
          "account",
          "amount"
        ],
        "properties": {
          "account": {
            "$ref": "#/components/schemas/account"
          },
          "amount": {
            "type": "string",
            "description": "Amount to be checked for availability represented as 999999999999999999.99."
          }
        },
        "description": "",
        "example": {
          "account": {
            "accountNumber": "600811111111",
            "bankId": "BOFAGB22"
          },
          "amount": "1000.00"
        }
      },
      "FundsCheckResponse": {
        "required": [
          "fundsAvailable"
        ],
        "type": "object",
        "properties": {
          "fundsAvailable": {
            "type": "string",
            "description": "Response 'true' if sufficient funds available or 'false' if unavailable"
          }
        },
        "example": {
          "fundsAvailable": true
        }
