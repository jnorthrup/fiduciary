  "paths": {
    "/cashpro/reporting/v1/funds-checks": {
      "post": {
        "tags": [
          "Funds Checks"
        ],
        "summary": "Funds checks query CashPro Information Reporting Current Day account balance information to determine if the amount requested is available in the account or not. This inquiry supports a single account for the current date.",
        "operationId": "currentDayFundChecks",
        "parameters": [
          {
            "name": "Content-Type",
            "in": "header",
            "description": "Identifying the content of the payload as JSON. </br> ex. application/json",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "Authorization",
            "in": "header",
            "description": "A unique access token to be used for a single reporting request. </br> (ex. 'Bearer [value]')",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "description": "Funds Check Request Body",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/fundsCheckAPI"
              }
