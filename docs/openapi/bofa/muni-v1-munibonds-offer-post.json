            "example": "RV"
          },
          "preRefunded": {
            "type": "boolean",
            "description": "Is the bond pre-refunded?",
            "example": false
          },
          "premiumCallDate": {
            "type": "string",
            "description": "Call date to the premium. Expected format YYYY-MM-DD. All numbers.",
