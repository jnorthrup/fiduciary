      "offerResponse": {
        "type": "object",
        "properties": {
          "maturityYield": {
            "type": "number",
            "format": "float",
            "description": "Yield to Maturity of security"
          },
          "minimumDenomination": {
            "type": "integer",
            "description": "Minimum denomination of bond to trade. For example, 50000 of quantity",
            "example": 5000
          },
          "multiples": {
            "type": "integer",
            "description": "Minimum denomination of bond to trade. For example 5000 increments of quantity beyond 50000",
            "example": 5000
          },
          "offerCredit": {
            "type": "number",
            "format": "float",
            "description": "Production credit on the offer"
          },
          "offerPrice": {
            "type": "number",
            "format": "float",
            "description": "Offering price of a bond"
          },
          "offerSize": {
            "type": "integer",
            "minimum": 0,
            "description": "Size of the available inventory of the bond. In 1000s. If 50 bonds are required, 50,000 should be specified (In words, that number is \u201cfifty thousand\u201d)",
            "example": 145000
          },
          "offerYield": {
            "type": "number",
            "format": "float",
            "description": "Yield of the bond"
          },
          "priceToDate": {
            "type": "string",
            "description": "The workout date corresponding to the yield to worst Expected. format YYYY-MM-DD. All numbers.",
            "example": "2019-06-01"
          },
          "priceToIndicator": {
            "type": "string",
            "description": "An indicator of the workout date for the yield to worst \u2018MATURITY\u2019 or \u2018CALL\u2019",
            "example": "MATURITY"
          },
          "subjectFirm": {
            "type": "string",
            "description": "Indicates the type of offer \n\u2018FIRM\u2019 \u2013 firm price that can be executed electronically \n\u2018SUBJ\u2019 \u2013 price subject to negotiation, no electronic execution",
            "example": "Firm"
          },
          "security": {
            "type": "array",
            "description": "Details below",
            "items": {
              "$ref": "#/components/schemas/securityDetails"
            }
          }
        }
      },
      "securityDetails": {
        "type": "object",
        "properties": {
          "amtBond": {
            "type": "boolean",
