      "OfferSearchRequest": {
        "type": "object",
        "properties": {
          "criteria": {
            "type": "array",
            "description": "Array of offer search criteria",
            "items": {
              "$ref": "#/components/schemas/OfferCriteriaItem"
            }
          }
        },
        "description": "Offer search request"
      },
      "OfferCriteriaItem": {
        "type": "object",
        "properties": {
          "field": {
            "type": "string",
            "description": "Field represent different offer criteria properties.<br><br>'field': 'Cusip'<br> 'description': CUSIP with or without the 9th check digit<br>'type': 'string' <br> 'additional': Only the \u201c=\u201d operand supported. It can be a comma separated list<br><br> 'field': 'Coupon' <br> 'description': Coupon of the bond<br>'type': 'number' <br> 'additional': Operands \u201c<=\u201d, \u201c>=\u201d and \u201c=\u201c supported<br><br> 'field': 'offerPrice' <br> 'description': Offering price of a bond<br>'type': 'number'<br>'additional': Operands \u201c<=\u201d, \u201c>=\u201d and \u201c=\u201c supported<br><br> 'field': 'offerSize' <br> 'description': Size of the available inventory of the bond<br>'type': 'integer'<br>'minimum': 0 <br> 'additional': In 1000s. If 50 bonds are required, 50,000 should be specified. (In words that number is fifty thousand).<br><br> 'field': 'offerYield' <br> 'description': Yield of the bond<br>'type': 'number'<br>'format':'float' <br> 'additional': Operands \u201c<=\u201d, \u201c>=\u201d and \u201c=\u201c supported<br><br> 'field': 'maturityDate' <br> 'description': Maturity date of the bond<br>'type': 'string' <br> 'additional': Expected format YYYY-MM-DD. All numbers.<br><br> 'field': 'moodyRatingLong' <br> 'description': Moody Long term rating of the bond<br>'type': 'string' <br> 'additional': See <a href='https://www.moodys.com/sites/products/productattachments/ap075378_1_1408_ki.pdf' target='_blank'>Moodys </a>for allowed enumerations of rating. Section \u201cMoody\u2019s Long-Term Rating Definitions\u201d. Operands \u201c<=\u201d, \u201c>=\u201d and \u201c=\u201c supported.<br><br> 'field': 'spRatingLong' <br> 'description': S&P rating of the bond<br>'type': 'string' <br> 'additional': See <a href='https://www.standardandpoors.com/en_US/web/guest/article/-/view/sourceId/504352' target='_blank'>S&P</a> for allowed enumeration of ratings. See section \u201cLong-Term Issue Credit Ratings*\u201d. Operands \u201c<=\u201d, \u201c>=\u201d and \u201c=\u201c supported.<br><br> 'field': 'fitchRatingLong' <br> 'description': Fitch rating of the bond<br>'type': 'string' <br> 'additional': See <a href='https://en.wikipedia.org/wiki/Fitch_Ratings' target='_blank'>Wikipedia Fitch</a> for allowed enumeration of ratings. See section \u201cInvestment Scale\u201d. Operands \u201c<=\u201d, \u201c>=\u201d and \u201c=\u201c supported.<br><br> 'field': 'moodyUnderlyingIncludeOther' <br> 'description': Underlying rating of the bond<br>'type': 'string' <br> 'additional': See moodyRatingLong above<br><br> 'field': 'spUnderlyingIncludeOther' <br> 'description': Underlying rating of the bond<br>'type': 'string' <br> 'additional': See spRatingLong above<br><br> 'field': 'fitchUnderlyingIncludeOther' <br> 'description': Underlying rating of the bond<br>'type': 'string' <br> 'additional': See fitchRatingLong above<br><br> 'field': 'statesIssuance' <br> 'description': State of issuance of the bond<br>'type': 'string' <br> 'additional': See <a href='https://pe.usps.com/text/pub28/28apb.htm' target='_blank'>USPS</a> for state abbreviations honored<br><br> 'field': 'Amt' <br> 'description': Amortized bond<br>'type': 'Boolean' <br> 'additional': true/false. Only the \u201c=\u201d operand supported<br><br> 'field': 'bankQualified' <br> 'description': Bank qualified bond<br>'type': 'Boolean' <br> 'additional': true/false. Only the \u201c=\u201d operand supported<br><br> 'field': 'callable' <br> 'description': Is bond callable?<br>'type': 'Boolean' <br> 'additional': true/false. Only the \u201c=\u201d operand supported<br><br> 'field': 'cpiFloating' <br> 'description': Floater<br>'type': 'Boolean' <br> 'additional': true/false. Only the \u201c=\u201d operand supported<br><br> 'field': 'escrow' <br> 'description': Escrowed to maturity?<br>'type': 'Boolean' <br> 'additional': true/false. Only the \u201c=\u201d operand supported<br><br> 'field': 'insurance' <br> 'description': Insured?<br>'type': 'Boolean' <br> 'additional': true/false. Only the \u201c=\u201d operand supported<br><br> 'field': 'prerefunded' <br> 'description': Pre-refunded?<br>'type': 'Boolean' <br> 'additional': true/false. Only the \u201c=\u201d operand supported<br><br> 'field': 'taxable' <br> 'description': Taxable?<br>'type': 'Boolean' <br> 'additional': true/false. Only the \u201c=\u201d operand supported<br><br> 'field': 'whenIssued' <br> 'description': When and If Issued?<br>'type': 'Boolean' <br> 'additional': true/false. Only the \u201c=\u201d operand supported<br><br> 'field': 'paySource' <br> 'description': Bond pay source<br>'type': 'string' <br> 'additional': GO. etc. Only the \u201c=\u201d operand supported. It can be a comma separated list<br><br> 'field': 'sector' <br> 'description': Bond sector<br>'type': 'string' <br> 'additional': Only the \u201c=\u201d operand supported. It can be a comma separated list<br>"
          },
