          },
          "issuer": {
            "type": "string",
            "description": "Description of the bond issuer",
            "example": "STATE HEFA HLTH"
          },
          "maturityDate": {
            "type": "string",
            "description": "Maturity Date of the bond.Expected format YYYY-MM-DD. All numbers.",
            "example": "2019-06-01"
          },
          "moodyRatingLong": {
            "type": "string",
            "description": "Moody\u2019s rating of the bonds",
            "example": null
          },
          "moodyRatingUnderlying": {
            "type": "string",
            "description": "Underlying rating of the bond",
            "example": null
          },
          "obligor": {
            "type": "string",
            "description": "Description of the bond obligor",
            "example": "SAMPLE HEALTHCARE ORGANIZATIO"
          },
          "parCallDate": {
            "type": "string",
            "description": "Date of par call",
