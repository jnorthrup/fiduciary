      "searchResponseDetails": {
        "type": "object",
        "properties": {
          "account": {
            "type": "string",
            "description": "Your firm\u2019s account number at BofA Securities if you are an Institutional customer. If you are a broker/dealer, it will be your EBN symbol prefixed with \u201cEBN\u201d <br>If you are a broker/dealer, your operations team will be able to provide you the EBN symbol to use. For (a possibly out of date) list, see DTCC. Ex. Merrill Lynch, Pierce, Fenner & Smith Inc. has MLCO as the symbol and you would provide \u201cEBNMLCO\u201d in the request."
          },
          "cusip": {
            "type": "string",
            "description": "CUSIP with or without the 9th check digit"
          },
          "productType": {
            "type": "string",
            "description": "Type of TEMMS product. For example VRDO or tender option bond"
          },
          "resetMode": {
            "type": "string",
            "description": "Rate reset frequency for the issue. For example, DAILY/WEEKLY/MONTHLY/OTHER"
          },
          "moodyRatingShort": {
            "type": "string",
            "description": "Moody Long- or Short-term rating of the bond. See <a href='https://www.moodys.com/sites/products/productattachments/ap075378_1_1408_ki.pdf' target='_blank'>Moodys</a> for allowed enumerations of rating. Section \u201cMoody\u2019s Long-Term Rating Definitions\u201d. May have a &#60;null&#62; value"
          },
          "moodyRatingLong": {
            "type": "string",
            "description": "Moody Long- or Short-term rating of the bond. See <a href='https://www.moodys.com/sites/products/productattachments/ap075378_1_1408_ki.pdf' target='_blank'>Moodys</a> for allowed enumerations of rating. Section \u201cMoody\u2019s Long-Term Rating Definitions\u201d. May have a &#60;null&#62; value"
          },
          "spRatingLong": {
            "type": "string",
            "description": "S&P Long- or Short-term rating of the bond. See<a href='https://www.standardandpoors.com/en_US/web/guest/article/-/view/sourceId/504352' target='_blank'> S&P</a> for allowed enumeration of ratings. See section \u201cLong-Term Issue Credit Ratings*\u201d. May have a &#60;null&#62; value"
          },
          "spRatingShort": {
            "type": "string",
            "description": "S&P Long- or Short-term rating of the bond. See<a href='https://www.standardandpoors.com/en_US/web/guest/article/-/view/sourceId/504352' target='_blank'> S&P</a> for allowed enumeration of ratings. See section \u201cLong-Term Issue Credit Ratings*\u201d. May have a &#60;null&#62; value"
          },
          "fitchRatingsLong": {
            "type": "string",
            "description": "Fitch Long- and Short-term rating of the bond. See <a href='https://en.wikipedia.org/wiki/Fitch_Ratings' target='_blank'> Wikipedia Fitch</a> for allowed enumeration of ratings. See section \u201cInvestment Scale\u201d. May have a &#60;null&#62; value"
          },
          "fitchRatingsShort": {
            "type": "string",
            "description": "Fitch Long- and Short-term rating of the bond. See <a href='https://en.wikipedia.org/wiki/Fitch_Ratings' target='_blank'> Wikipedia Fitch</a> for allowed enumeration of ratings. See section \u201cInvestment Scale\u201d. May have a &#60;null&#62; value"
          },
          "minimumDenomination": {
            "type": "integer",
            "description": "Minimum trade denomination in number of bonds"
          },
          "multiples": {
            "type": "integer",
            "description": "Increment of trade denomination"
          },
          "issueCode": {
            "type": "string",
            "description": "Internal deal code for issue"
          },
          "privatePlacement": {
            "type": "string",
            "description": "Indicator whether deal is a private placement<br> Values are \u201cY\u201d or \u201cN\u201d "
          },
          "creditProvider": {
            "type": "string",
            "description": "Description of the issue\u2019s credit provider"
          },
          "issueDescription": {
            "type": "string",
            "description": "Description of the issue"
          },
          "liquidityProvider": {
            "type": "string",
            "description": "Description of the issue\u2019s liquidity provider"
          },
          "tradeId": {
            "type": "integer",
            "description": "Your (BofA Securities generated) trade reference number"
          },
          "tradeDate": {
            "type": "string",
            "description": "Date the trade was executed. Expected format YYYY-MM-DD. All numbers."
          },
          "price": {
            "type": "number",
            "description": "Price the trade is executed at"
          },
          "tradeStatus": {
            "type": "string",
            "description": "The various states that a trade can be in. <br> Trade status changes state in the below order: <br>  1. Submitted <br>  2. Pending ( or \u201cPendAlloc\u201d)<br>  3. Executed <br>  4. Denied <br> Two other states are <br>  5.  Allocated <br>  6. Cancelled <br>When the trade has been received by BofA Securities via the trade request API, its state will be Submitted. When it is queued for execution but has not yet been executed, it will be in the state Pending. <br>Executed or Denied are the end states depending on the whether the trade has completed successfully or not <br>Allocated indicates a trade has been moved from the pending account it was book at to a settlement account, and Cancelled means a trade has been cancelled."
          },
          "settlementDate": {
            "type": "string",
            "description": "Settlement date expected. Should match settlement dates offered by BofA Securities. Expected format YYYY-MM-DD. All numbers."
          },
          "coupon": {
            "type": "number",
            "format": "float",
            "description": "Coupon rate of the issue"
          },
          "accruedInterest": {
            "type": "number",
            "format": "float",
            "description": "Accrued interest to settlement date"
          },
          "creationTimeStamp": {
            "type": "string",
            "description": "Time the trade record was originally created (See \u2018updateTimeStamp\u2019 for format details)"
          },
          "updateTimeStamp": {
            "type": "string",
            "description": "Time the trade record was updated. <br>ISO 8601 date time format specifying date and time with HH, MM, SS and without time zone offsets. Time zone is always expected to be US Eastern. See Wikipedia (<a href='https://en.wikipedia.org/wiki/ISO_8601' target='_blank'>Link</a>) for ISO 8601. If caller uses Java, it is this (<a href='https://commons.apache.org/proper/commons-lang/apidocs/org/apache/commons/lang3/time/DateFormatUtils.html#ISO_8601_EXTENDED_DATE_FORMAT' target='_blank'>Link</a>) Apache Commons Lang date time format (ISO_8601_EXTENDED_DATE_FORMAT)"
          },
          "temmsTradeType": {
            "type": "string",
            "description": "Future use. May have a &#60;null&#62; value"
          },
          "user": {
            "type": "string",
            "description": "Name of the person entering or updating the trade"
          },
          "transactionType": {
            "type": "string",
            "description": "Indication if trade is Buy or Sell<br>Side is from your perspective. You, the customer, are BUYing from or SELLing to BofA Securities"
          },
          "quantityDollarAmount": {
            "type": "integer",
            "description": "Transaction quantity <br>In 1000s. If 50 bonds are required, 50000 should be specified. In words that number is \u201cfifty thousand\u201d "
          },
          "parentTradeId": {
            "type": "integer",
            "description": "If trade has been moved or allocated from a previous, this is the original trade\u2019s ID. May have a &#60;null&#62; value"
          },
          "errorMessage": {
            "type": "string",
            "description": "Error message for specific response. May have a &#60;null&#62; value"
          }
        }
      },
