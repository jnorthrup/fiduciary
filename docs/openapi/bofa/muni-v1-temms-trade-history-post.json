                "operand": "=",
                "value": "AALUTH"
              },
              {
                "field": "accountNumber",
                "operand": "=",
                "value": "12345667"
              },
              {
                "field": "productType",
                "operand": "=",
                "value": "VRDO"
              },
              {
                "field": "resetMode",
                "operand": "=",
                "value": "DAILY"
              },
              {
                "field": "status",
                "operand": "=",
                "value": "Submitted"
              },
              {
                "field": "tradeIdFrom",
                "operand": ">=",
                "value": "111111"
              },
              {
                "field": "tradeIdTo",
                "operand": "<=",
                "value": "222222"
              },
              {
                "field": "creationDateFrom",
                "operand": ">=",
                "value": "2020-03-22"
              },
              {
                "field": "creationDateTo",
                "operand": "<=",
                "value": "2020-03-26"
              }
            ]
          }
        }
      },
      "searchRequestTradeHistory": {
        "required": [
          "criteria"
        ],
        "type": "object",
        "description": "Trade History search request. Please see the Code Table API for details of each field\u2019s dropdowns",
        "properties": {
          "criteria": {
            "type": "array",
            "description": "Array of Trade History search criteria",
            "items": {
              "$ref": "#/components/schemas/criteriaTradeHistory"
            }
          }
        }
      },
      "criteriaTradeHistory": {
        "type": "object",
        "required": [
          "field"
        ],
        "properties": {
          "field": {
            "type": "string",
            "description": "Field represent different Trade History criteria properties.   <br><br>'field': 'Cusip' <i>optional</i><br>'description': CUSIP with or without the 9th check digit<br>'type': 'string'<br>'additional': Only the \u201c=\u201d operand supported.<br><br>'field': 'investorSymbol' <i>optional</i><br>'description': Internal symbol related to the account group \u2013 please see Code Table API to retrieve permissible values<br>'type': 'string'<br>'additional': Only the \u201c=\u201d operand supported.<br><br>'field': 'accountNumber' <i>optional</i><br>'description': Your firm\u2019s account number at BofA Securities if you are an Institutional customer. If you are a broker/dealer, it will be your EBN symbol prefixed with \u201cEBN\u201d.<br>'type': 'string'<br>'additional': Only the \u201c=\u201d operand supported. <br>If you are a broker/dealer, your operations team will be able to provide you the EBN symbol to use. For (a possibly out of date) list, see DTCC. Ex. Merrill Lynch, Pierce, Fenner & Smith Inc. has MLCO as the symbol and you would provide \u201cEBNMLCO\u201d in the request<br><br>'field': 'productType' <i>optional</i><br>'description': Type of TEMMS product - please see Code Table API to retrieve permissible values<br>'type': 'string'<br>'additional': Only the \u201c=\u201d operand supported. For example VRDO or tender option bond<br><br>'field': 'resetMode' <i>optional</i><br>'description': Rate reset mode - please see Code Table API to retrieve permissible values<br>'type': 'string'<br>'additional': Only the \u201c=\u201d operand supported.<br><br>'field': 'tradeStatus' <i>optional</i><br>'description': Indicator of the status of the trade<br>'type': 'string'<br>'additional': Only the \u201c=\u201d operand supported. <br> Permissible values:<br>  \u2022 \u201cSubmitted\u201d <br>  \u2022 \u201cPendAlloc\u201d<br>  \u2022 \u201cCancelled\u201d<br>  \u2022 \u201cDenied\u201d<br>  \u2022 \u201cExecuted\u201d<br>  \u2022 \u201cAllocated\u201d<br><br>'field': 'tradeIdFrom' <i>optional</i><br>'description': Your BofA Securities generated trade reference number<br>'type': 'number'<br>'additional': Only the \u201c>=\u201d operand supported for <b>tradeIdFrom</b> Only the \u201c<=\u201d operand supported for <b>tradeIdTo</b><br><br>'field': 'tradeIdTo' <i>optional</i><br>'description': Your BofA Securities generated trade reference number<br>'type': 'number'<br>'additional': Only the \u201c>=\u201d operand supported for <b>tradeIdFrom</b> Only the \u201c<=\u201d operand supported for <b>tradeIdTo</b><br><br>'field': 'creationDateFrom' <i>optional</i><br>'description': Date of trade<br>'type': 'string'<br>'additional':Only the \u201c>=\u201d operand supported for <b>creationDateFrom</b> Only the \u201c<=\u201d operand supported for <b>creationDateTo</b>. Expected format YYYY-MM-DD. All numbers \u2013 range of dates trades were done by.<br><br>'field': creationDateTo' <i>optional</i><br>'description': Date of trade<br>'type': 'string'<br>'additional':Only the \u201c>=\u201d operand supported for <b>creationDateFrom</b> Only the \u201c<=\u201d operand supported for <b>creationDateTo</b>. Expected format YYYY-MM-DD. All numbers \u2013 range of dates trades were done by. <br><br>Note: that all fields do not need to be filled out, and all empty fields will pull back the entire trade history"
          },
          "value": {
            "type": "string",
            "description": "Value set for criteria field"
          },
          "operand": {
            "type": "string",
            "description": "Valid operand corresponding to field."
          }
        }
      },
