  "components": {
    "schemas": {
      "rateHistoryAPI": {
        "required": [
          "searchRequest"
        ],
        "type": "object",
        "properties": {
          "searchRequest": {
            "$ref": "#/components/schemas/searchRequestRateHistory"
          }
        },
        "example": {
          "searchRequest": {
            "dateFrom": "2010-12-19",
            "dateTo": "2020-03-26",
            "cusip": "00037NKX3"
          }
        }
      },
      "searchRequestRateHistory": {
        "description": "Search request for rates",
        "type": "object",
        "required": [
          "dateFrom",
          "dateTo",
          "cusip"
        ],
        "properties": {
          "dateFrom": {
            "type": "string",
            "description": "Date for the rates to be retrieved from Expected format YYYY-MM-DD. All numbers."
          },
          "dateTo": {
            "type": "string",
            "description": "Date for the rates to be retrieved to Expected format YYYY-MM-DD. All numbers."
          },
          "cusip": {
            "type": "string",
            "description": "CUSIP with or without the 9th check digit"
          }
        }
      },
      "rateHistory": {
        "type": "object",
        "properties": {
          "cusip": {
            "type": "string",
            "description": "CUSIP with or without the 9th check digit"
          },
          "resetMode": {
            "type": "string",
            "description": "Rate reset mode"
          },
          "issueDescription": {
            "type": "string",
            "description": "Detailed text description of the issue"
          },
          "rateHistoryDetails": {
            "type": "array",
            "description": "Array of \u201cn\u201d rates applied to business",
            "items": {
              "$ref": "#/components/schemas/rateHistoryDetails"
            }
          },
          "avg90Days": {
            "type": "number",
            "description": "Average of rate over the 90 days previous to the \u201cTo\u201d date <br> May have a &#60;null&#62; value"
          },
          "avg180Days": {
            "type": "number",
            "description": "Average of rate over the 180 days previous to the \u201cTo\u201d date <br> May have a &#60;null&#62; value"
          },
          "avg365Days": {
            "type": "number",
            "description": "Average of rate over the 365 days previous to the \u201cTo\u201d date <br> May have a &#60;null&#62; value"
          }
        },
        "example": {
          "rateHistory": {
            "cusip": "00037NKX3",
            "resetMode": "WEEKLY",
            "issueDescription": "ABAG Colma Bart Family Apartments 2002A",
            "rateHistoryDetails": [
              {
                "rate": 0.36,
                "effectiveRateDate": "2010-12-19"
              },
              {
                "rate": 0.36,
                "effectiveRateDate": "2010-12-20"
              },
              {
                "rate": 0.36,
                "effectiveRateDate": "2010-12-21"
              }
            ]
          }
        }
      },
      "rateHistoryDetails": {
        "type": "object",
        "properties": {
          "rate": {
            "type": "number",
            "description": "Interest rate applied"
          },
          "effectiveRateDate": {
            "type": "string",
            "description": "Specific date the rate applies. Expected format YYYY-MM-DD. All numbers."
          }
        }
      },
