  "paths": {
    "/muni/v1/temms/rate/history": {
      "post": {
        "tags": [
          "Global Markets - Muni Services"
        ],
        "summary": "APIs that allow BofA Securities customers of Municipal Banking and Markets to transact Municipal securities. This API provides the customer the ability to retrieve the rate history of a specific issue",
