    "/muni/v1/munibonds/tradenegotiation": {
      "put": {
        "tags": [
          "Global Markets \u2013 new trade negotiation",
          "Muni Services"
        ],
        "summary": "APIs that allow BofA Securities customers of Municipal Banking and Markets to transact Municipal securities. This API provides the customer the ability to counter a muni bond offer by price/yield and negotiate/trade on it.",
        "operationId": "",
