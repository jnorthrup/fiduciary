  "components": {
    "schemas": {
      "TradeNegotiationRequestBody": {
        "required": [
          ""
        ],
        "type": "object",
        "properties": {
          "negotiationRequest": {
            "type": "array",
            "description": "",
            "items": {
              "$ref": "#/components/schemas/negotiationRequestItem"
            }
          }
        },
        "example": {
          "negotiationRequest": [
            {
              "accountNumberOrEbn": "89A30051",
              "cusip": "007266KS7",
              "referenceNumber": 0,
              "price": 113.419,
              "yield": 2,
              "quantity": 50000,
              "negotiationType": "PRICE",
              "negotiationAction": "COUNTER"
            }
          ]
        }
      },
      "negotiationRequestItem": {
        "type": "object",
        "required": [
          "accountNumberOrEbn",
          "cusip",
          "price",
          "yield",
          "quantity",
          "negotiationType",
          "negotiationAction"
        ],
        "properties": {
          "accountNumberOrEbn": {
            "type": "string",
            "description": "Your firm\u2019s account number at BofA Securities if you are an Institutional customer. If you are a broker/dealer, it will be your EBN symbol prefixed with \u201cEBN\u201d<br><br>If you are a broker/dealer, your operations team will be able to provide you the EBN symbol to use. For (a possibly out of date) list, see DTCC. Ex. Merrill Lynch, Pierce, Fenner & Smith Inc. has MLCO as the symbol and you would provide \u201cEBNMLCO\u201d in the request."
          },
          "cusip": {
            "type": "string",
            "description": "CUSIP with or without the 9th check digit"
          },
          "referenceNumber": {
            "type": "integer",
            "description": "Your BofA Securities generated negotiation reference number"
          },
          "price": {
            "type": "number",
            "description": "Price entered for negotiation"
          },
          "yield": {
            "type": "number",
            "description": "Yield entered for negotiation"
          },
          "quantity": {
            "type": "integer",
            "description": "Transaction quantity<br><br>In 1000s. If 50 bonds are required, 50000 should be specified. In words that number is \u201cfifty thousand\u201d"
          },
          "negotiationType": {
            "type": "string",
            "description": "Whether negotiation is Price-based or Yield-based<br><br>Must contain \u201cPRICE\u201d or \u201cYIELD\u201d"
          },
          "negotiationAction": {
            "type": "string",
            "description": "Action of this negotiation \u2013 i.e. \u201cCOUNTER\u201d"
          }
        }
      },
      "TradeNegotiationResponseBody": {
        "type": "object",
        "properties": {
          "negotiationResponse": {
            "type": "array",
            "description": "",
            "items": {
              "$ref": "#/components/schemas/negotiationResponseItems"
            }
          }
        },
        "description": "Response successfully retrieved",
        "example": {
          "negotiationResponse": [
            {
              "negotiationType": "PRICE",
              "negotiationAction": "COUNTER",
              "cusip": "007266KS7",
              "quantity": 50000,
              "price": 113.419,
              "yield": 2,
              "referenceNumber": 166,
              "accountNumberOrEbn": "89A30051",
              "hasError": true,
              "errorMessage": "No offer found for cusip 64578CAH4.",
              "errorType": null,
              "validationErrors": [],
              "confirmations": [],
              "systemErrors": null
            }
          ]
        }
      },
      "negotiationResponseItems": {
        "type": "object",
        "properties": {
          "negotiationType": {
            "type": "string",
            "description": "Whether negotiation is Price-based or Yield-based<br><br>Contains \u201cPRICE\u201d or \u201cYIELD\u201d"
          },
          "negotiationAction": {
            "type": "string",
            "description": "Echo back from the request"
          },
          "cusip": {
            "type": "string",
            "description": "Echo back from the request"
          },
          "quantity": {
            "type": "integer",
            "description": "Echo back from the request"
          },
          "price": {
            "type": "number",
            "description": "Echo back from the request"
          },
          "yield": {
            "type": "number",
            "description": "Echo back from the request"
          },
          "referenceNumber": {
            "type": "integer",
            "description": "Your (BofA Securities generated) trade reference number"
          },
          "settlementDate": {
            "type": "string",
            "description": "Settlement date for the security"
          },
          "accountNumberOrEbn": {
            "type": "string",
            "description": "Echo back from the request"
          },
          "hasError": {
            "type": "boolean",
            "description": "If there were errors when processing the request<br><br>True/False"
          },
          "errorMessage": {
            "type": "string",
            "description": "Messages if hasError is true. While every effort will be made to notify and co-ordinate when these error message text change, BofA Securities reserves the right to change the text without notice."
          },
          "errorType": {
            "type": "string",
            "description": "Future use"
          },
          "validationErrors": {
            "type": "array",
            "description": "Future Use",
            "items": {}
          },
          "confirmations": {
            "type": "array",
            "description": "Future Use",
            "items": {}
          },
          "systemErrors": {
            "type": "string",
            "description": "Technical failures on BofA Securities end. These could be transient or permanent. You do not have to correct your input if you retry."
          }
        }
