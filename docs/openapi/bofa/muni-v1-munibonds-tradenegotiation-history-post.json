      "searchResponse": {
        "type": "object",
        "properties": {
          "negotiationId": {
            "type": "integer",
            "description": "Your BofA Securities generated negotiation reference number"
          },
          "negotiationStatus": {
            "type": "string",
            "description": "The various states that a negotiation can be in<br><br><br>\u2022\u201cCountered\u201d \u2013 Customer has countered the BofA offering<br>\u2022\"Trader Accepted\" \u2013 BofA securities has accepted the customer\u2019s counter and may trade at the counter price.<br>\u2022\"Trader Countered\" \u2013 BofA securities has countered back to the customer with a counter price or yield<br>\u2022\"Accepted\" \u2013 Customer has accepted the BofA securities\u2019 counter<br>\u2022\"Trader Counter Expired\" \u2013 The timer after BofA securities countered  expired <br>\u2022\"Denied\" \u2013 The counter request was denied due to technical error.<br>\u2022\"Executed\" \u2013 The negotiation resulted in a trade <br>"
          },
          "quantity": {
            "type": "integer",
            "description": "Transaction quantity<br><br>In 1000s. If 50 bonds are required, 50000 should be specified. In words that number is \u201cfifty thousand\u201d<br>"
          },
          "accountNumberOrEbn": {
            "type": "string",
            "description": "Your firm\u2019s account number at BofA Securities if you are an Institutional customer. If you are a broker/dealer, it will be your EBN symbol prefixed with \u201cEBN\u201d.<br><br>If you are a broker/dealer, your operations team will be able to provide you the EBN symbol to use. For (a possibly out of date) list, see DTCC. Ex. Merrill Lynch, Pierce, Fenner & Smith Inc. has MLCO as the symbol and you would provide \u201cEBNMLCO\u201d in the request<br>"
          },
          "cusip": {
            "type": "string",
            "description": "CUSIP with or without the 9th check digit"
          },
          "counterPrice": {
            "type": "number",
            "description": "Price of the Counter on the Trade"
          },
          "counterYield": {
            "type": "number",
            "description": "Yield on the Counter of the Trade"
          },
          "side": {
            "type": "string",
            "description": "Indication if trade is Buy or Sell<br><br>Side is from your perspective. You, the customer, are BUYing from or SELLing to BofA Securities<br>"
          },
          "accruedInterest": {
            "type": "number",
            "description": "Accrued interest to settlement date"
          },
          "settlementDate": {
            "type": "string",
            "description": "Settlement date expected. Should match settlement dates offered by BofA Securities.<br><br>Expected format YYYY-MM-DD. All numbers.<br>"
          },
          "longtermTrade": {
            "type": "array",
            "description": "",
            "items": {
              "$ref": "#/components/schemas/longtermTrade"
            }
          },
          "tsMemo": {
            "type": "string",
            "description": "Reason text of status is Denied"
          },
          "negotiationExpireTime": {
            "type": "string",
            "description": "The time at which the negotiation with expire"
          },
          "negotiationType": {
            "type": "string",
            "description": "Indicates whether negotiation is a Price or Yield"
          },
          "isOfferBestAndFinal": {
            "type": "string",
            "description": "Indicates whether offer is further negotiable"
          }
        }
      },
      "longtermTrade": {
        "type": "object",
        "description": "Details of the trade itself<br>",
        "properties": {
          "tradeId": {
            "type": "integer",
            "description": "Your (BofA Securities generated) trade reference number<br>"
          },
          "side": {
            "type": "string",
            "description": "Indication if trade is Buy or Sell<br><br>Side is from your perspective. You, the customer, are BUYing from or SELLing to BofA Securities<br>"
          },
          "quantity": {
            "type": "integer",
            "description": "Transaction quantity<br><br>In 1000s. If 50 bonds are required, 50000 should be specified. In words that number is \u201cfifty thousand\u201d<br>"
          },
          "tradeStatus": {
            "type": "string",
            "description": "The various states that a trade can be in<br><br>Trade status changes state in the below order:<br>1.Submitted<br>2.Pending<br>3.Executed<br>4.Denied<br><br>When the trade has been received by BofA Securities via the trade request API, its state will be Submitted. When it is queued for execution but has not yet been executed, it will be in the state Pending. Executed or Denied are the end states depending on the whether the trade has completed successfully or not<br>"
          },
          "tsMemo": {
            "type": "string",
            "description": "Deprecated"
          },
          "tradeDate": {
            "type": "string",
            "description": "Date the trade was executed<br><br>Expected format YYYY-MM-DD. All numbers.<br>"
          },
          "settlementDate": {
            "type": "string",
            "description": "Settlement date expected. Should match settlement dates offered by BofA Securities.<br><br>Expected format YYYY-MM-DD. All numbers.<br>"
          },
          "principal": {
            "type": "number",
            "description": "Trade principal based on the par and price"
          },
          "accruedInterest": {
            "type": "number",
            "description": "Accrued interest to settlement date"
          },
          "tsAccruedInterest": {
            "type": "number",
            "description": "Deprecated"
          },
          "totalCost": {
            "type": "number",
            "description": "Total cost of the trade including principal and accrued interest"
          },
          "tradePrice": {
            "type": "number",
            "description": "Price the trade is executed at"
          },
          "tradeYield": {
            "type": "number",
            "description": "Yield the trade is executed at"
          },
          "tradeCredit": {
            "type": "number",
            "description": "Future use"
          },
          "worstYield": {
            "type": "number",
            "description": "Yield to worst"
          },
          "currentYield": {
            "type": "number",
            "description": "Current yield of the bond"
          },
          "taxEqvYield": {
            "type": "number",
            "description": "Tax-equivalent yield at trade level"
          },
          "premiumCallDate": {
            "type": "string",
            "description": "Call date to the premium<br><br>Expected format YYYY-MM-DD. All numbers.<br>"
          },
          "premiumCallPrice": {
            "type": "number",
            "description": "Price to the premium call"
          },
          "premiumCallYield": {
            "type": "number",
            "description": "yield to the premium call"
          },
          "parCallDate": {
            "type": "string",
            "description": "Date of the Par Call<br><br>Expected format YYYY-MM-DD. All numbers."
          },
          "parCallPrice": {
            "type": "number",
            "description": "Price to the Par Call date"
          },
          "parCallYield": {
            "type": "number",
            "description": "Yield to the Par Call date"
          },
          "maturityYield": {
            "type": "number",
            "description": "Yield to Maturity"
          },
          "maturityDate": {
            "type": "string",
            "description": "Maturity date of the bond<br><br>Expected format YYYY-MM-DD. All numbers."
          },
          "maturityPrice": {
            "type": "number",
            "description": "Price to Maturity"
          },
          "priceToIndicator": {
            "type": "string",
            "description": "An indicator of the workout date for the yield to worst<br><br>\u2018MATURITY\u2019 or \u2018CALL\u2019"
          },
          "priceToPrice": {
            "type": "number",
            "description": "The price corresponding to the priceToIndicator"
          },
          "priceToDate": {
            "type": "string",
            "description": "The workout date corresponding to the yield to worst<br><br>Expected format YYYY-MM-DD. All numbers."
          },
          "stepOutIndicator": {
            "type": "boolean",
            "description": "Is BofA Securities stepping out of this trade<br><br>Talk to your operations team for this type of trade, a custodian is usually involved to take possession of the securities"
          },
          "user": {
            "type": "string",
            "description": "Echo back of the calling BofA Securities user\u2019s ID"
          },
          "updateTimeStamp": {
            "type": "string",
            "description": "Time the trade record was updated<br><br>ISO 8601 date time format specifying date and time with HH, MM, SS and without time zone offsets. Time zone is always expected to be US Eastern. See Wikipedia (<a href='https://en.wikipedia.org/wiki/ISO_8601' target='_blank'>Link</a>) for ISO 8601. If caller uses Java, it is this (<a href='https://commons.apache.org/proper/commons-lang/apidocs/org/apache/commons/lang3/time/DateFormatUtils.html#ISO_8601_EXTENDED_DATE_FORMAT' target='_blank'>Link</a>) Apache Commons Lang date time format (<br>ISO_8601_EXTENDED_DATE_FORMAT)"
          },
          "cusip": {
            "type": "string",
            "description": "CUSIP with or without the 9th check digit"
          },
          "accountNumberOrEbn": {
            "type": "string",
            "description": "Your firm\u2019s account number at BofA Securities if you are an Institutional customer. If you are a broker/dealer, it will be your EBN symbol prefixed with \u201cEBN\u201d<br><br>If you are a broker/dealer, your operations team will be able to provide you the EBN symbol to use. For (a possibly out of date) list, see DTCC. Ex. Merrill Lynch, Pierce, Fenner & Smith Inc. has MLCO as the symbol and you would provide \u201cEBNMLCO\u201d in the request."
          }
        }
      },
