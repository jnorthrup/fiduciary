            "$ref": "#/components/schemas/searchRequest"
          }
        },
        "example": {
          "searchRequest": {
            "criteria": [
              {
                "field": "negotiationIdFrom",
                "operand": ">=",
                "value": "1274"
              },
              {
                "field": "negotiationIdTo",
                "operand": "<=",
                "value": "1274"
              },
              {
                "field": "cusip",
                "operand": "=",
                "value": "016059DT1"
              },
              {
                "field": " accountNumberOrEbn ",
                "operand": "=",
                "value": "89A30051"
              },
              {
                "field": "investorSymbol",
                "operand": "=",
                "value": "OLDKENT"
              },
              {
                "field": "negotiationStatus",
                "operand": "=",
                "value": "Denied"
              },
              {
                "field": "creationDateFrom",
                "operand": ">=",
                "value": "2022-03-23"
              },
              {
                "field": "creationDateTo",
                "operand": "<=",
                "value": "2022-03-23"
              }
            ]
          }
        }
      },
      "searchRequest": {
        "type": "object",
        "description": "Trade Negotiation History search request <br><br>See \u201cSample Request\u201d below",
        "properties": {
          "criteria": {
            "type": "array",
            "description": "Array of Trade negotiation history search criteria See \u201cSample Request\u201d below.",
            "items": {
              "$ref": "#/components/schemas/criteriaItem"
            }
          }
        }
      },
      "criteriaItem": {
        "type": "object",
        "properties": {
          "field": {
            "type": "string",
            "description": "Field represent different offer criteria properties. <br><br>'field': 'negotiationIdFrom'<br>'description': Your BofA Securities generated negotiation reference number <br><br>Only the \u201c>=\u201d operand supported for negotiationIdFrom <br>Only the \u201c<=\u201d operand supported for negotiationIdTo <br>'type': 'integer'<br><br>'field': 'negotiationIdTo'<br>'description': Your BofA Securities generated negotiation reference number <br><br>Only the \u201c>=\u201d operand supported for negotiationIdFrom <br>Only the \u201c<=\u201d operand supported for negotiationIdTo <br>'type': 'integer'<br><br>'field': 'cusip'<br>'description': CUSIP with or without the 9th check digit <br><br>Only the \u201c=\u201d operand supported. <br>'type': 'string'<br><br>'field': 'accountNumberOrEbn'<br>'description': Your firm\u2019s account number at BofA Securities if you are an Institutional customer. If you are a broker/dealer, it will be your EBN symbol prefixed with \u201cEBN\u201d. <br><br>Only the \u201c=\u201d operand supported.<br><br>If you are a broker/dealer, your operations team will be able to provide you the EBN symbol to use. For (a possibly out of date) list, see DTCC. Ex. Merrill Lynch, Pierce, Fenner & Smith Inc. has MLCO as the symbol and you would provide \u201cEBNMLCO\u201d in the request <br>'type': 'string'<br><br>'field': 'investorSymbol'<br>'description': Internal symbol related to the account group \u2013 please see Code Table API to retrieve permissible values <br><br>Only the \u201c=\u201d operand supported. <br>'type': 'string'<br><br>'field': 'negotiationStatus'<br>'description': Indicator of the status of the negotiation <br><br>Only the \u201c=\u201d operand supported <br><br>Permissible values: <ul><li>\u201cCountered\u201d</li><li>\u201cTrader Accepted\u201d</li><li>\u201cTrader Countered\u201d</li><li>\u201cAccepted\u201d</li><li>\u201cTrader Counter Expired\u201d</li><li>\u201cDenied\u201d</li><li>\u201cExecuted\u201d</li></ul> <br>'type': 'string' <br>'notes': <ul><li>\u201cCountered\u201d \u2013 Customer has countered the BofA offering</li><li>\u201cTrader Accepted\u201d \u2013 BofA securities has accepted the customer\u2019s counter and may trade at the counter price.</li><li>\u201cTrader Countered\u201d \u2013 BofA securities has countered back to the customer with a counter price or yield</li><li>\u201cAccepted\u201d \u2013 Customer has accepted the BofA securities\u2019 counte</li><li>\u201cTrader Counter Expired\u201d \u2013 The timer after BofA securities countered  expired </li><li>\u201cDenied\u201d \u2013 The counter request was denied due to technical error.</li><li>\u201cExecuted\u201d \u2013 The negotiation resulted in a trade securities has countered back to the customer with a counter price or yield</li><li>\u201cAccepted\u201d \u2013 Customer has accepted the BofA securities\u2019 counter</li><li>\u201cTrader Counter Expired\u201d \u2013 The timer after BofA securities countered  expired.</li><li>\u201cDenied\u201d \u2013 The counter request was denied due to technical error.</li><li>\u201cExecuted\u201d \u2013 The negotiation resulted in a trade.</li></ul><br><br>'field': 'creationDateFrom'<br>'description': Date of Negotiation <br><br>Only the \u201c>=\u201d operand supported for creationDateFrom <br>Only the \u201c<=\u201d operand supported for creationDateTo <br><br>Expected format YYYY-MM-DD. All numbers \u2013 range of dates trades were done by <br>'type': 'string'<br><br>'field': 'creationDateTo'<br>'description': Date of Negotiation <br><br>Only the \u201c>=\u201d operand supported for creationDateFrom <br>Only the \u201c<=\u201d operand supported for creationDateTo <br><br>Expected format YYYY-MM-DD. All numbers \u2013 range of dates trades were done by <br>'type': 'string'"
          },
          "operand": {
            "type": "string",
            "description": "Valid operand corresponding to field."
          },
          "value": {
            "type": "string",
            "description": "Value set for criteria field."
          }
        }
      },
