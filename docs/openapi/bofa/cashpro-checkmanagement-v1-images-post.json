  "paths": {
    "/cashpro/checkmanagement/v1/images": {
      "post": {
        "tags": [
          "Check Services"
        ],
        "summary": "Our Check Image Retrieval service allows you to obtain images for paid checks within the retention period associated with a check disbursement account",
        "operationId": "",
        "parameters": [
          {
            "name": "Authorization",
            "in": "header",
            "description": "An unexpired access token to be used for this request (ex. 'Bearer [value]'). Length: 256",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "traceId",
            "in": "header",
            "description": "unique per request. Length: 50",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "companyId",
            "in": "header",
            "description": "Unique company identifier - CashPro Company  ID. Length: 15",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "companyType",
            "in": "header",
            "description": "Static text. Value = External",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "Accept",
            "in": "header",
            "description": "Static text. Value = application/json",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "Content-Type",
            "in": "header",
            "description": "Identifies the content of the payload as JSON. Value = application/json",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "maxImageCount",
            "in": "header",
            "description": "Maximum number of images returned from API. Length: 4",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
