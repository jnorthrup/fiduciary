      "CheckViewerOutModel": {
        "type": "object",
        "required": [
          "Id",
          "Status",
          "Message",
          "Amount",
          "CheckNumber",
          "imageCount"
        ],
        "properties": {
          "Id": {
            "type": "string",
            "description": "unique id per image. Length: 12"
          },
          "Status": {
            "type": "string",
            "description": "Status of image"
          },
          "Message": {
            "type": "string",
            "description": "Response Message"
          },
          "Amount": {
            "type": "string",
            "description": "Check amount. Format: 9999999.99"
          },
          "CheckNumber": {
            "type": "string",
            "description": "Check Number. Max Length: 12"
          },
          "frontImage": {
            "type": "string",
            "description": "Contains the scanned copy of face of check. Image in base64 format. Size: 50KB"
          },
          "backImage": {
            "type": "string",
            "description": "Contains the scanned copy of back of check. Image in base64 format. Size: 50KB"
          },
          "imageCount": {
            "type": "string",
            "description": "Number of retrieved images out of available images that matched the query parameters. Length: 4"
          },
          "paidDate": {
            "type": "string",
            "description": "Date check was paid. Format: YYYY-MM-DD"
          }
        }
