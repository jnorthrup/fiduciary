  "components": {
    "schemas": {
      "inquiryCheckInModel": {
        "type": "object",
        "required": [
          "accountNumber",
          "fromDate",
          "toDate"
        ],
        "properties": {
          "accountNumber": {
            "type": "string",
            "description": "The account number associated with check images to be retrieved. Max Length: 12 digits "
          },
          "fromCheckNumber": {
            "type": "string",
            "description": "Starting check number within desired range. Max Length: 12 digits"
          },
          "toCheckNumber": {
            "type": "string",
            "description": "Ending check number within desired range. Max Length: 12 digits"
          },
          "fromAmount": {
            "type": "string",
            "description": "Starting check amount within desired range. Format: 9999999.99"
          },
          "toAmount": {
            "type": "string",
            "description": "Ending check amount within desired range. Format: 9999999.99"
          },
          "fromDate": {
            "type": "string",
            "description": "Starting check paid date. Format: YYYY-MM-DD. Cannot be future dated; fromDate and toDate should not be more than 90 days "
          },
          "toDate": {
            "type": "string",
            "description": "Ending check paid date. Format: YYYY-MM-DD. Cannot be future dated; fromDate and toDate should not be more than 90 days"
          }
        },
        "example": {
          "accountNumber": "1416000004",
          "fromCheckNumber": "1000",
          "toCheckNumber": "5000",
          "fromAmount": "1000.00",
          "toAmount": "15000.00",
          "fromDate": "2019-05-08",
          "toDate": "2019-07-30"
        }
      },
      "ResponseEntity": {
        "type": "object",
        "required": [
          "totalItems",
          "imagesReturned",
          "Message",
          "Status"
        ],
        "properties": {
          "totalItems": {
            "type": "integer",
            "description": "Total number of images found based upon the query parameters. Length: 4"
          },
          "imagesReturned": {
            "type": "integer",
            "description": "Total number of images returned in the response. Length: 4"
          },
          "Message": {
            "type": "string",
            "description": "Response message. SUCCESS or see list of possible response messages"
          },
          "Status": {
            "type": "string",
            "description": "Response code"
          },
          "unProcessedItems": {
            "type": "integer",
            "description": "Total number of unprocessed images Length: 4"
          },
          "processedList": {
            "type": "array",
            "description": "List of processed checks; Viewer entity",
            "items": {
              "$ref": "#/components/schemas/CheckViewerOutModel"
            }
          },
          "unProcessedList": {
            "type": "array",
            "description": "List of unprocessed checks; Viewer entity",
            "items": {
              "$ref": "#/components/schemas/CheckViewerOutModel"
            }
          }
        },
        "example": {
          "imagesReturned": 17,
          "message": "SUCCESS",
          "processedList": [
            {
              "frontImage": "iVBORw0KGgoAAAANSUhEUgAAB+AAAAM+AQAAAAACsSUNAAAACXBIWXMAACTpAAAk6QFQJ",
