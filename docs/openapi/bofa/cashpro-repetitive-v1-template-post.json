  "paths": {
    "/cashpro/repetitive/v1/template": {
      "post": {
        "tags": [
          "Repetitive Payments"
        ],
        "summary": "Payment Initiations Template allows creation of a single repetitive payment instruction through CashPro Global Payments with or without schedule information. Upon delivery the template information is entered with the basic details required in Global Payments workflow for approvals or repair.",
        "operationId": "template-create",
        "parameters": [
          {
            "name": "Content-Type",
            "in": "header",
            "description": "Identifying the content of the payload as JSON",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "X-Idempotency-Key",
            "in": "header",
            "description": "A unique identifier to be used for a single payment  <br>Length: 1 - 256",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "Authorization",
            "in": "header",
            "description": "A unique access token to be used for a single reporting request (ex. 'Bearer [value]')",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "description": "Request Body",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/paymentInitiationTemplateCreation"
              }
            }
