  "paths": {
    "/cashpro/repetitive/v1/templates": {
      "get": {
        "tags": [
          "Repetitive Payments"
        ],
        "summary": "Payment Initiations provides facility to retrieve a template information maintained in CashPro Global Payments.",
        "operationId": "pymtInitTemp7",
        "parameters": [
          {
            "name": "X-Idempotency-Key",
            "in": "header",
            "description": "A unique identifier to be used for a single payment<br>Length: 1 - 256",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "Authorization",
            "in": "header",
            "description": "A unique access token to be used for a single reporting request (ex. 'Bearer [value]')",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "templateIdentification",
            "in": "header",
            "description": "Unique template identification generated by CashPro Global Payments <br>Length: 1 - 35",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/paymentInitiationRetrieveDetailsResponse"
