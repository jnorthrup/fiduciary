  "components": {
    "schemas": {
      "getPortfolio": {
        "type": "object",
        "required": [
          "portfolioName",
          "token"
        ],
        "properties": {
          "portfolioName": {
            "type": "string",
            "description": "The portfolio name used in the Create Portfolio API",
            "example": "MyCustomPortfolio 1.0"
          },
          "token": {
            "type": "string",
            "description": "The token provided in Create Portfolio API response",
            "example": "9572d7f4e812df12cd8c0d26e7308864c33cbb51b004cbe962ad545bc377a4a2"
          }
        }
      },
      "getPortfolioResponse": {
        "type": "object",
        "required": [
          "portfolioName",
          "clientRequestId",
          "token",
          "errorMessage",
          "status",
          "portfolio"
        ],
        "properties": {
          "portfolioName": {
            "type": "string",
            "description": "Echo back of the Portfolio name",
            "example": "MyCustomPortfolio 1.0"
          },
          "clientRequestId": {
            "type": "string",
            "description": "This is the clientRequestId provided in the request header",
            "example": "4a251a2ef9bbf4ccc35f97aba2c9cbda"
          },
          "token": {
            "type": "string",
            "description": "Echo back of the token provided in Create Portfolio API response",
            "example": "9572d7f4e812df12cd8c0d26e7308864c33cbb51b004cbe962ad545bc377a4a2"
          },
          "errorMessage": {
            "type": "string",
            "description": "Errors, if any, while creating new portfolio",
            "example": null
          },
          "status": {
            "type": "string",
            "description": "Portfolio creation status",
            "example": "COMPLETED"
          },
          "portfolio": {
            "$ref": "#/components/schemas/portfolioDetails"
          }
        }
      },
      "portfolioDetails": {
        "type": "object",
        "required": [
          "userId",
          "username",
          "portfolioName",
          "portfolioType",
          "optimizerGenerated",
          "createdTime",
          "modifiedTime",
          "analytics"
        ],
        "properties": {
          "userId": {
            "type": "string",
            "description": "User Id of the creator of the Portfolio as registered on the Bofa Securities Mercury\u2122 platform",
            "example": "user123"
          },
          "username": {
            "type": "string",
            "description": "User name corresponding to the User Id as registered on Bofa Securities Mercury\u2122 platform. This is an echo back that can be used in grids that display lists of Portfolios that are created",
            "example": "john bob"
          },
          "portfolioName": {
            "type": "string",
            "description": "Echo back of the Portfolio name",
            "example": "MyCustomPortfolio 1.0"
          },
          "portfolioType": {
            "type": "string",
            "description": "Active. This is a constant",
            "example": "My Active"
          },
          "optimizerGenerated": {
            "type": "boolean",
            "description": "Was it generated by an optimizer? In this version, this is always true",
            "example": true
          },
          "holdingsAccountNumber": {
            "type": "string",
            "description": "Future use. May be deprecated",
            "example": null
          },
          "createdTime": {
            "type": "string",
            "description": "Create time of the Portfolio",
            "example": "1567528206380"
          },
          "modifiedTime": {
            "type": "string",
            "description": "Create time of the Portfolio. Expect it to match the createdTime",
            "example": "1567528206380"
          },
          "analytics": {
            "type": "string",
            "description": "Analytics data associated with the Portfolio. See Sample Response",
            "example": "{'parValue': 930000, 'principalValue,: 989136.799,'accruedInterest': 7298.611,'portfolioValue': 996435.411,'annualIncome':45350,'averageMaturity': {'dateStr':2021/11/23},'averagePrice':106.532,'averageYTW': 2.165, 'averageYTM': 2.165 }"
          },
          "optimizerCriteria": {
            "type": "string",
            "description": "Future use. Always NULL in this version",
            "example": null
          },
          "productionCredit": {
            "type": "string",
            "description": "credit applied to portfolio positions",
            "example": null
          }
        },
        "description": "portfolio detail if status is completed"
      },
