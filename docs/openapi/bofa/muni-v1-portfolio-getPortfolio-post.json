{
  "openapi": "3.0.1",
  "info": {
    "title": "Global Markets \u2013 Get Portfolio",
    "description": "Muni Bond Portfolio Services API 2 of 2: Allows a user to retrieve a Muni portfolio through Muni services. This API would be called after a call of the Create Portfolio API.",
