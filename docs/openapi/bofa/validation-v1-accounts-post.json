  "openapi": "3.0.1",
  "info": {
    "title": "US Account Validation",
    "description": "Account Validation allows you to pre-authenticate the owner or status of a bank account, prior to sending a U.S. ACH credit, debit, real-time payment, or wire transfer. This can help reduce payments to unintended receivers and returned transaction (for invalid account, no account, unauthorized debit, etc.). You must also give us access to an endpoint that will allow us to asynchronously notify you of the validation results. This is a separate implementation, and is sometimes known as a webhook, push notification, or callback.",
    "license": {
      "name": "Apache 2.0",
      "url": "http://www.apache.org/licenses/LICENSE-2.0.html"
    },
    "version": "1.0.0",
    "x-additionalDocs": {
      "overview": {
        "fileName": "validation-v1-accounts-post-overview.json"
      }
    }
  },
