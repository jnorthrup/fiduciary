      "criteriaDescription": {
        "type": "object",
        "description": "Purpose of criteria",
        "required": [
          "name",
          "selectedValue"
        ],
        "properties": {
          "name": {
            "type": "string",
            "description": "Criteria name",
            "example": "advanced_Option"
          },
          "valueType": {
            "type": "string",
            "description": "Data type for criteria, this is just for reference so client knows what is valid data type for selectedValue, not mandatory",
            "example": "stringListMultiSelect"
          },
          "displayName": {
            "type": "string",
            "description": "Meaningful name of the criteria, it is just for reference and not required in create portfolio request",
            "example": "Exclude States"
          },
          "Required": {
            "type": "string",
            "description": "True=criteria is mandatory, false=criteria is optional, it is just for reference and not required in create portfolio request",
            "example": "false"
          },
          "listOfValues": {
            "type": "string",
            "description": "If this is present in criteria template then selected value has to be from list of values, it is just for reference and not required in create portfolio request",
            "example": "['AL', 'AK', 'AZ', 'AR', 'CA', 'CO', 'CT', 'DE', 'FL', 'GA', 'HI', 'ID', 'IL', 'IN', 'IA', 'KS', 'KY', 'LA', 'ME', 'MD', 'MA', 'MI', 'MN', 'MS', 'MO', 'MT', 'NE', 'NV', 'NH', 'NJ', 'NM', 'NY', 'NC', 'ND', 'OH', 'OK', 'OR', 'PA', 'RI', 'SC', 'SD', 'TN', 'TX', 'UT', 'VT', 'VA', 'WA', 'WV', 'WI', 'WY', 'DC', 'PR', 'VI', 'AS', 'GU', 'MP'],"
