        "type": "object",
        "properties": {
          "portfolioName": {
            "type": "string",
            "description": "Echo back of the Portfolio name",
            "example": "MyCustomPortfolio 1.0"
          },
          "clientRequestId": {
            "type": "string",
            "description": "This is the clientRequestId provided in the request header",
            "example": "4a251a2ef9bbf4ccc35f97aba2c9cbda"
          },
          "token": {
            "type": "string",
            "description": "A token provided to help retrieve the portfolio in a subsequent request, the Get Portfolio API. The portfolio may take time to construct and client code would need to poll at a reasonable interval to retrieve the constructed portfolio. Future versions of the API would be enhanced with advice on the estimated time of completion which can be used to adjust polling interval",
            "example": "9572d7f4e812df12cd8c0d26e7308864c33cbb51b004cbe962ad545bc377a4a2"
          },
          "errorMessage": {
            "type": "string",
            "description": "Any errors in creating the portfolio. If there is an error, there will be no portfolio to retrieve",
            "example": null
          },
          "status": {
            "type": "string",
            "description": "Portfolio creation status",
            "example": "PENDING"
          },
          "portfolio ": {
            "type": "string",
            "description": "It will be null in create portfolio response. See \u201ctoken\u201d above. Future versions of the API will respond with the portfolio or provide a token if the portfolio needs to be retrieved with the Get Portfolio API",
            "example": null
          }
