          },
          "maxValue": {
            "type": "string",
            "description": "What can be the maximum value of criteria, it is just for reference and not required in create portfolio request",
            "example": "null"
          },
          "defaultValue": {
            "type": "string",
            "description": "Default suggested value for criteria, it is just for reference and not required in create portfolio request",
            "example": "null"
          },
          "selectedValue": {
            "type": "string",
            "description": "User selected value of criteria, if valueType is stringListMultiSelect then user can selected multiple values using \u201c|\u201ddelimiter",
            "example": "null"
