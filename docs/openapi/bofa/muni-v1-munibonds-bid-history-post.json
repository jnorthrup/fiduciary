      "searchResponseItem": {
        "type": "object",
        "properties": {
          "bidId": {
            "type": "integer",
            "description": "BofA Securities number identifying the Bid"
          },
          "bidAnwseredCount": {
            "type": "integer",
            "description": "Indication of number of times the Bid has been answered"
          },
          "quantity": {
            "type": "integer",
            "description": "Transaction quantity of the bid desired In 1000s. If 50 bonds are required, 50000 should be specified. In words that number is 'fifty thousand'"
          },
          "bidStatus": {
            "type": "string",
            "description": "Workflow status of the bid response 'Submitted', 'Answered', 'Pending', or 'Executed'"
          },
          "userMemo": {
            "type": "string",
            "description": "Memo to self for the person submitting the bid request. Optional"
          },
          "tsMemo": {
            "type": "string",
            "description": "Future Use"
          },
          "tsReason": {
            "type": "string",
            "description": "Future Use"
          },
          "bidRequestDate": {
            "type": "string",
            "description": "Business date the bid is for"
          },
          "settlementDate": {
            "type": "string",
            "description": "Future Use"
          },
          "tsAccruedInterest": {
            "type": "number",
            "description": "Accrued interest on the bid wanted"
          },
          "bidByTime": {
            "type": "string",
            "description": "The earliest time in the business day that a bid request can be submitted ISO 8601 date time format specifying date and time with HH, MM, SS and without time zone offsets. Time zone is always expected to be US Eastern. See Wikipedia (Link) for ISO 8601. If caller uses Java, it is this (Link) Apache Commons Lang date time format ( ISO_8601_EXTENDED_DATE_FORMAT)"
          },
          "firmTillTime": {
            "type": "string",
            "description": "The latest time the quoted price will be firm after which it becomes subject and cannot be executed electronically See 'Additional Notes' for bidByTime for format and expectations"
          },
          "user": {
            "type": "string",
            "description": "User ID of the bid submitter"
          },
          "updatedTimeStamp": {
            "type": "string",
            "description": "Last time bid record was updated"
          },
          "cusip": {
            "type": "string",
            "description": "CUSIP with or without the 9th check digit"
          },
          "details": {
            "$ref": "#/components/schemas/searchResponseItemsDetails"
          },
          "accountNumberOrEbn": {
            "type": "string",
            "description": ""
          }
        },
        "description": ""
