      "bidWantedSearchRequest": {
        "required": [
          "searchRequest"
        ],
        "type": "object",
        "properties": {
          "searchRequestObject": {
            "$ref": "#/components/schemas/searchRequestObject"
          }
        },
        "description": "",
        "example": {
          "searchRequest": {
            "criteria": [
              {
                "field": "cusip",
                "operand": "=",
                "value": "64985TAG6"
              },
              {
                "field": "bidsWantedIdFrom",
                "operand": ">=",
                "value": 12121
              },
              {
                "field": "bidsWantedIdTo",
                "operand": "<=",
                "value": 12121
              },
              {
                "field": "bidDueTimeFrom",
                "operand": ">=",
                "value": "2024-07-19T00:00:00-04:00"
              },
              {
                "field": "bidDueTimeTo",
                "operand": "<=",
                "value": "2024-07-19T15:00:00-04:00"
              },
              {
                "field": "bidFirmTimeFrom",
                "operand": ">=",
                "value": "2024-07-19T00:00:00-04:00"
              },
              {
                "field": "bidFirmTimeTo",
                "operand": "<=",
                "value": "2024-07-19T00:15:00-04:00"
              },
              {
                "field": "settlementDate",
                "operand": ">=",
                "value": "2024-07-19"
              }
            ]
          }
        }
      },
      "searchRequestObject": {
        "type": "object",
        "properties": {
          "criteria": {
            "type": "array",
            "description": "Array of bid search criteria",
            "items": {
              "$ref": "#/components/schemas/criteriaObject"
            }
          }
        },
        "description": "Bid search request"
      },
      "criteriaObject": {
        "type": "object",
        "properties": {
          "field": {
            "type": "string",
            "description": "Field represents different criteria properties.<br><br>'field': 'cusip'<br>'description': CUSIP with or without the 9th check digit. <br>'type': 'string'<br><br>'field': 'bidsWantedIdFrom'<br>'description': Bids Wanted Id range. <br>'type': 'Whole Number'<br>'additional': Operand \u201c>=\u201d supported in From <br><br>'field': 'bidsWantedIdTo'<br>'description': Bids Wanted Id range. <br>'type': 'Whole Number'<br>'additional': Operand \u201c<=\u201d supported in To<br><br>'field': 'bidDueTimeFrom'<br>'description': Bid due time range. <br>'type': 'DateTime'<br>'additional': Operand \u201c>=\u201d supported. <br><br>'field': 'bidDueTimeTo'<br>'description': Bid due time range. <br>'type': 'DateTime'<br>'additional': Operand \u201c<=\u201d supported. <br><br>'field': 'bidFirmTimeFrom'<br>'description': Bid firm time range. <br>'type': 'DateTime'<br>'additional': Operand \u201c>=\u201d supported. <br><br>'field': 'bidFirmTimeTo'<br>'description': Bid firm time range. <br>'type': 'DateTime'<br>'additional': Operand \u201c<=\u201d supported. <br><br>'field': 'settlementDate'<br>'description': CUSIP settlement date. <br>'type': 'Date'"
          },
          "operand": {
            "type": "string",
            "description": "Valid operand corresponding to field"
          },
          "value": {
            "type": "string",
            "description": "Value set for criteria field"
          }
        }
      },
      "ResponseBody": {
        "type": "object",
        "properties": {
          "searchResponse": {
            "type": "array",
            "description": "",
            "items": {
              "$ref": "#/components/schemas/searchResponseObject"
            }
          }
        },
        "description": "",
        "example": {
          "searchResponse": [
            {
              "cusip": "007266KS7",
              "quantity": 50000,
              "bidDueTime": "2024-07-19T02:00:00-04:00",
              "bidFirmTime": "2024-07-19T07:00:00-04:00",
              "settlementDate": "2024-07-27",
              "bidsWantedId": 898989,
              "timestamp": "2024-07-19T00:00:00-04:00"
            }
          ]
        }
      },
      "searchResponseObject": {
        "type": "object",
        "properties": {
          "cusip": {
            "type": "string",
            "description": "CUSIP with or without the 9th check digit"
          },
          "quantity": {
            "type": "integer",
            "format": "Whole Number",
            "description": "Bid quantity"
          },
          "bidDueTime": {
            "type": "string",
            "format": "DateTime",
            "description": "Time bid is due | collection period for the bid request"
          },
          "bidFirmTime": {
            "type": "string",
            "format": "DateTime",
            "description": "Wire time for the bid execution"
          },
          "settlementDate": {
            "type": "string",
            "format": "Date",
            "description": "CUSIP settlement date"
          },
          "bidsWantedId": {
            "type": "number",
            "format": "Whole Number",
            "description": "Original bid request number"
          },
          "timeStamp": {
            "type": "string",
            "format": "DateTime",
            "description": "Bid answered time"
          }
        }
      },
