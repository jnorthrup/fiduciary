      },
      "addressLine": {
        "required": [
          "address"
        ],
        "type": "object",
        "properties": {
          "address": {
            "type": "string",
            "description": "",
            "example": "Beneficiary Address Line 1"
          }
        }
      },
      "identifier": {
        "type": "object",
        "required": [
          "identification",
          "schemeName",
          "issuer"
        ],
        "properties": {
          "identification": {
            "type": "string",
            "description": "An alpha numeric value that can uniquely identify a party within the specified issuer. Length : 1 \u2013 35"
          },
          "schemeName": {
            "type": "string",
            "description": "Identification scheme such as SSN, Drivers License, National Id, Tax Id. Length : 1 \u2013 35"
          },
          "issuer": {
            "type": "string",
            "description": "The organization that issued the identification. Length : 1 \u2013 35"
          }
        }
      },
      "contactDetail": {
        "type": "object",
        "description": "Contact details of the party.",
        "properties": {
          "name": {
            "type": "string",
            "description": "Name of the contact. Length 1-140"
          },
          "phoneNumber": {
            "type": "string",
            "description": "Phone Number of the contact. Length 1 - 30",
            "example": "800 555 1212"
          },
          "mobileNumber": {
            "type": "string",
            "description": "Mobile Number of the contact. Length 1-30"
          },
          "faxNumber": {
            "type": "string",
            "description": "Fax Number of the contact. Length 1-30"
          },
          "emailAddress": {
            "type": "string",
            "description": "Email Address of the contact. Length : 1 \u2013 2048"
          }
        }
      },
      "paymentType": {
        "required": [
          "serviceLevel"
        ],
        "type": "object",
        "description": "Indication of the type of payment being initiated",
        "properties": {
          "serviceLevel": {
            "type": "string",
            "description": "Agreement under which or rules under which the transaction should be processed enum: \"URGP\",\"SDVA\",\"SEPA\",\"NURG\",\"\" <br>Usage: \u201cURGP\u201d indicates high value wire transaction. \u201cNURG\u201d indicates local low value transaction."
          },
          "localInstrument": {
            "type": "string",
            "description": "User community specific instrument. Length : 1-35"
          },
          "categoryOfPurpose": {
            "type": "string",
            "description": "Specifies the high level purpose of the instruction based on a set of pre-defined categories. Usage: This is used by the initiating party to provide information concerning the processing of the payment. It is likely to trigger special processing by any of the agents involved in the payment chain. Length : 1-35"
          }
        }
