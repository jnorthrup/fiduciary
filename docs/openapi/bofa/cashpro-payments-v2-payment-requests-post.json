        "type": "object",
        "required": [
          "name",
          "identification"
        ],
        "description": "The Financial Institution details",
        "properties": {
          "name": {
            "type": "string",
            "description": "The name of the Financial Institution."
          },
          "identification": {
            "type": "string",
            "description": "An alpha numeric value that can uniquely identify the Financial Institution based on a specific Scheme."
          },
          "schemeName": {
            "type": "string",
            "description": "Identification scheme within which the identifier is unique, such as BIC, OTHERS."
          },
          "issuer": {
            "type": "string",
            "description": "The organization that issued the identification."
          },
          "postalAddress": {
            "$ref": "#/components/schemas/portalAddress"
          }
        }
      },
      "portalAddress": {
        "type": "object",
        "required": [
          "addressLine",
          "city",
          "countrySubDivision",
          "country"
        ],
        "description": "Address of the party",
        "properties": {
          "addressLine": {
            "type": "array",
            "description": "Address of the party. Length : 1 \u2013 70 <br> Min: 1<br> Max: 2",
            "items": {}
          },
          "city": {
            "type": "string",
            "description": "City of the party. Length : 1 \u2013 35"
          },
          "countrySubDivision": {
            "type": "string",
            "description": "Identifies a subdivision of a country, for instance state, region, or province. Length : 1-35"
          },
          "country": {
            "type": "string",
            "description": "ISO country code of the party. Length : 2"
          },
          "postalCode": {
            "type": "string",
            "description": "Identifier consisting of a group of letters and/or numbers that is added to a postal address to assist the sorting of mail. Length : 1-16"
          }
        }
      },
      "branch": {
        "type": "object",
        "required": [
          "name",
          "identification"
        ],
        "description": "The Branch details",
        "properties": {
          "name": {
            "type": "string",
            "description": "The name of the Financial Institution."
          },
          "identification": {
            "type": "string",
            "description": "An alpha numeric value that can uniquely identify the Financial Institution based on a specific Scheme. Length 1-35"
          },
          "postalAddress": {
            "$ref": "#/components/schemas/portalAddress"
          }
        }
      },
      "partyIdentification": {
        "type": "object",
        "required": [
          "name",
          "type",
          "postalAddress"
        ],
        "properties": {
          "name": {
            "type": "string",
            "description": "Name of the party. Length : 1 - 140"
          },
          "type": {
