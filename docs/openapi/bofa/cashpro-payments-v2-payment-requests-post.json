            "description": "Enumeration indicating whether the party is an organization or a private individual"
          },
          "postalAddress": {
            "$ref": "#/components/schemas/postalAddress"
          },
          "identifiers": {
            "type": "array",
            "description": "Identification details for the party.",
            "items": {
              "$ref": "#/components/schemas/identifier"
            }
          },
          "dateOfBirth": {
            "type": "string",
            "description": "Date of Birth of an Individual"
          },
          "countrySubDivisionOfBirth": {
            "type": "string",
            "description": "State, Province or County of Birth of an Individual"
          },
          "cityOfBirth": {
            "type": "string",
            "description": "City of Birth of an Individual"
          },
          "countryOfBirth": {
            "type": "string",
            "description": "County of Birth of an Individual (ISO country code). Length : 2"
          },
          "countryOfResidence": {
            "type": "string",
            "description": "The country in which the party resides (ISO country code). Length : 2"
          },
          "contactDetails": {
            "$ref": "#/components/schemas/contactDetail"
          }
        }
      },
      "postalAddress": {
        "type": "object",
        "required": [
          "addressLine",
          "city",
          "country"
        ],
        "description": "Address of the party",
        "properties": {
          "addressLine": {
            "type": "array",
            "description": "Address of the party Length : 1 - 70 Min: 1 Max: 2",
            "items": {
              "$ref": "#/components/schemas/addressLine"
            }
          },
          "city": {
            "type": "string",
            "description": "City of the party Length : 1 - 35",
            "example": "Beneficiary City"
          },
          "countrySubDivision": {
            "type": "string",
            "description": "Identifies a subdivision of a country, for instance state, region, or province. Length : 1-35"
          },
          "country": {
            "type": "string",
            "description": "ISO country code of the party Length : 2",
            "example": "GB"
          },
          "postalCode": {
            "type": "string",
            "description": "Identifier consisting of a group of letters and/or numbers that is added to a postal address to assist the sorting of mail. Length : 1-16"
          }
