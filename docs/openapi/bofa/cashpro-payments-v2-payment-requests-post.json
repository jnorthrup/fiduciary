      "paymentIdentification": {
        "type": "object",
        "required": [
          "instructionIdentification",
          "endToEndIdentification"
        ],
        "description": "Payment identification references",
        "properties": {
          "instructionIdentification": {
            "type": "string",
            "description": "Unique identification as assigned by an instructing party for an instructed party to unambiguously identify the instruction. Length : 1 - 35",
            "example": "instrId123"
          },
          "endToEndIdentification": {
            "type": "string",
            "description": "Unique identification assigned by the initiating party to unumbiguously identify the transaction. This identification is passed on, unchanged, throughout the entire end-to-end chain.  Length : 1 - 35",
            "example": "e2eId123"
          },
          "UETR": {
            "type": "string",
            "description": "Unique End2End Transaction Reference",
            "example": "eb6305c9-1f7f-49de-aed0-16487c27b42d"
          }
        }
      },
      "amount": {
        "type": "object",
        "required": [
          "value"
        ],
        "description": "Amount of the transaction",
        "properties": {
          "value": {
            "type": "string",
            "description": "Amount of the transaction represented as 9999999999.99. Length: 1 - 13",
            "example": "1.00"
          },
          "type": {
            "type": "string",
            "description": "Specifies whether the payment is a fixed debit (equivalent) or fixed credit (instructed) payment. enum: \"CREDIT\", \"DEBIT\"",
            "example": "CREDIT"
          },
          "amountModificationAllowed": {
            "type": "boolean",
            "description": ""
          }
        }
      },
      "account": {
        "required": [
          "identification"
        ],
        "type": "object",
        "properties": {
          "identification": {
            "type": "string",
            "description": "Account number or identification. Length : 1 \u2013 256"
          },
          "schemeName": {
            "type": "string",
            "description": "Name of the identification scheme. <br>enum: 'IBAN', 'BBAN', 'EMAIL', 'PHONE', 'CARD'"
          },
          "currency": {
            "type": "string",
            "description": "The Currency of the account.Required for creditor account. Length : 3"
          },
          "name": {
            "type": "string",
            "description": "Name of the Account."
          }
        }
      },
      "financialInstitution": {
        "type": "object",
        "required": [
          "institution"
        ],
        "properties": {
          "institution": {
            "$ref": "#/components/schemas/institutionv2"
          },
          "branch": {
            "$ref": "#/components/schemas/branch"
          }
        }
      },
