      "newIssueDealDetails": {
        "type": "object",
        "description": "",
        "properties": {
          "dealVersion": {
            "type": "integer",
            "description": "Version number of the deal, which indicates how many times the deal has changed"
          },
          "dealId": {
            "type": "integer",
            "description": "BofA generated numeric identifier for the deal"
          },
          "dealDescription": {
            "type": "string",
            "description": "Description of the deal itself"
          },
          "seniorManager": {
            "type": "string",
            "description": "The lead firm responsible for the deal <br><br>e.g. \u201cBofA Securities, NY\u201d"
          },
          "expectedPricingDate": {
            "type": "string",
            "description": "Date the deal is expected to be priced <br><br>Expected format YYYY-MM-DD <br>Can be null"
          },
          "dealStatus": {
            "type": "string",
            "description": "Status within the deal lifecycle <br><br>Example:  \u201cAllotments Available\u201d, \u201cAwaiting Allotments\u201d, \u201cNot Published\u201d, \u201cPreliminary Pricing\u201d, \u201cRetail Order Period\u201d, \u201cVerbal Award/CXL Window\u201d, \u201cDay-to-Day\u201d, \u201cPrice Ideas\u201d"
          },
          "dealSize": {
            "type": "integer",
            "description": "Overall size in actual dollar amount of the deal"
          },
          "dealMoodysRating": {
            "type": "string",
            "description": "Overall Moodys Long term rating of the issue <br><br>See <a href='https://www.moodys.com/sites/products/productattachments/ap075378_1_1408_ki.pdf' target='_blank'>Moodys</a> for allowed enumerations of rating. Section \u201cMoody\u2019s Long-Term Rating Definitions\u201d"
          },
          "dealSPRating": {
            "type": "string",
            "description": "Overall S&P rating of the issue. <br>See <a href='https://disclosure.spglobal.com/ratings/en/regulatory/article/-/view/sourceId/504352' target='_blank'>S&P</a> for allowed enumeration of ratings. See section \u201cLong-Term Issue Credit Ratings*\u201d."
          },
          "dealFitchRating": {
            "type": "string",
            "description": "Overall Fitch rating of the issue <br>See <a href='https://en.wikipedia.org/wiki/Fitch_Ratings' target='_blank'>Wikipedia Fitch</a> for allowed enumeration of ratings. See section \u201cInvestment Scale\u201d"
          },
          "firstMaturityDate": {
            "type": "string",
            "description": "Initial maturity date of components within of the deal <br><br>Expected format YYYY-MM-DD <br>Can be null"
          },
          "finalMaturityDate": {
            "type": "string",
            "description": "Initial maturity date of components within of the deal <br><br>Expected format YYYY-MM-DD <br>Can be null"
          },
          "state": {
            "type": "string",
            "description": "US state or territory <br><br>Expected format is two-letter code (\u201cNY\u201d, \u201cCA\u201d, \u201cHI\u201d)"
          },
          "taxStatus": {
            "type": "string",
            "description": "Indication of whether the deal has interest coupons that are taxable or tax-exempt or various"
          },
          "series": {
            "type": "array",
            "description": "Array describe the tranches/series within the deal <br><br>Minimum is one, can be many",
            "items": {
              "$ref": "#/components/schemas/series"
            }
          }
        }
      },
      "series": {
        "type": "object",
        "description": "Array describing one or more tranches/series within the deal \u2013 these are specific structures",
        "properties": {
          "seriesCode": {
            "type": "string",
            "description": "Issuer generated code identifying the specific series"
          },
          "seriesDescription": {
            "type": "string",
            "description": "Description of the specific series"
          },
          "taxable": {
            "type": "boolean",
            "description": "Indicates whether the deal is taxable <br><br>True or False"
          },
          "moodysRating": {
            "type": "string",
            "description": "Moodys Long term rating of the series <br><br>See <a href='https://www.moodys.com/sites/products/productattachments/ap075378_1_1408_ki.pdf' target='_blank'>Moodys</a> for allowed enumerations of rating. Section \u201cMoody\u2019s Long-Term Rating Definitions\u201d"
          },
          "sandPRating": {
            "type": "string",
            "description": "S&P rating of the series <br><br>See <a href='https://disclosure.spglobal.com/ratings/en/regulatory/article/-/view/sourceId/504352' target='_blank'>S&P</a> for allowed enumeration of ratings. See section \u201cLong-Term Issue Credit Ratings*\u201d."
          },
          "fitchRatingCode": {
            "type": "string",
            "description": "Fitch rating of the series <br><br>See <a href='https://en.wikipedia.org/wiki/Fitch_Ratings' target='_blank'>Wikipedia Fitch</a> for allowed enumeration of ratings. See section \u201cInvestment Scale\u201d"
          },
          "callFeatureDescription": {
            "type": "string",
            "description": "Freeform text describing the call features of the series"
          },
          "firstCouponDate": {
            "type": "string",
            "description": "First maturity date of components within of the series <br><br>Expected format YYYY-MM-DD <br>Can be null"
          },
          "datedDate": {
            "type": "string",
            "description": "Date the issue is expected to be locked down <br><br>Expected format YYYY-MM-DD"
          },
          "maturities": {
            "type": "array",
            "description": "Array describe the maturities within the series  <br><br>Minimum is one, can be many",
            "items": {
              "$ref": "#/components/schemas/maturities"
            }
          }
        }
      },
      "maturities": {
        "type": "object",
        "description": "Array describing one or more series within the deal \u2013 these are specific structures",
        "properties": {
          "maturityDate": {
            "type": "string",
            "description": "Initial maturity date of the bond <br><br>Expected format YYYY-MM-DD <br>Can be null"
          },
          "maturityAmount": {
            "type": "integer",
            "description": "Size of the bond <br><br>In 1000s. If 50 bonds are required, 50,000 should be specified (In words, that number is \u201cfifty thousand\u201d)."
          },
          "coupon": {
            "type": "number",
            "description": "Coupon of the bond"
          },
          "price": {
            "type": "number",
            "description": "Current price of the bond"
          },
          "yield": {
            "type": "number",
            "description": "Current yield of the bond"
          },
          "cusip": {
            "type": "string",
            "description": "CUSIP with or without the 9th check digit"
          },
          "spread": {
            "type": "number",
            "description": "Current spread against bond\u2019s benchmark"
          },
          "maturityDescription": {
            "type": "string",
            "description": "Description of the bond <br><br>May be null or blank"
          },
          "maturityStatus": {
            "type": "string",
            "description": "Indicates whether the maturity is active <br><br>Note:  This will normally be marked as \u201cACTIVE\u201d, and is reserved for future use"
          },
          "maturityHistory": {
            "type": "array",
            "description": "Array describe number of versions of the bond.   This shows changes over time in pricing, yield, quantity and other economic factors <br><br>Minimum is one, can be many",
            "items": {
              "$ref": "#/components/schemas/maturityHistory"
            }
          }
        }
      },
      "maturityHistory": {
        "type": "object",
        "description": "Array describing one or more series within the deal \u2013 these are specific structures",
        "properties": {
          "maturityVersion": {
            "type": "integer",
            "description": "Version number of the bond, incidcating how many times it has updated"
          },
          "sourceSystemTimestamp": {
            "type": "string",
            "description": "Timestamp of the version change <br><br>Format is YYYY-MM-DDTHH:MM:SS-HH:MM\u201d <br>The final HH:MM is the differential for GMT"
          },
          "coupon": {
            "type": "number",
            "description": "Coupon of the bond at time of the change <br><br>Can be null"
          },
          "price": {
            "type": "number",
            "description": "Price of the bond at time of the change <br><br>Can be null"
          },
          "yield": {
            "type": "number",
            "description": "Yield of the bond at time of the change <br><br>Can be null"
          },
          "spread": {
            "type": "number",
            "description": "Spread at time of the change <br><br>Can be null"
          },
          "maturityAmount": {
            "type": "integer",
            "description": "Size of the bond <br><br>In 1000s. If 50 bonds are required, 50,000 should be specified (In words, that number is \u201cfifty thousand\u201d)<br><br>Can be null"
          }
        }
      },
