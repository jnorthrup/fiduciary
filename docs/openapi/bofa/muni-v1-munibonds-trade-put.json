  "components": {
    "schemas": {
      "requestBody": {
        "required": [
          "orderRequest"
        ],
        "type": "object",
        "properties": {
          "orderRequest": {
            "type": "array",
            "description": "Array of orders. Minimum size 1.No cognizable upper bound but limited practically by available inventory\nSee below for field descriptions within object",
            "items": {
              "$ref": "#/components/schemas/requestBodyItem"
            }
          }
        },
        "example": {
          "orderRequest": [
            {
              "accountNumberOrEbn": "123456789",
              "confirmations": [],
              "cusip": "123456789",
              "bidId": 0,
              "price": 110.394,
              "quantity": 5000,
              "stepOutIndicator": true,
              "transactionType": "BUY"
            },
            {
              "accountNumberOrEbn": "123456789",
              "confirmations": [],
              "cusip": "123456789",
              "bidId": 1671293,
              "price": 110.394,
              "quantity": 5000,
              "stepOutIndicator": true,
              "transactionType": "SELL"
            }
          ]
        }
      },
      "requestBodyItem": {
        "type": "object",
        "required": [
          "accountNumberOrEbn",
          "confirmations",
          "cusip",
          "bidId",
          "price",
          "quantity",
          "stepOutIndicator",
          "transactionType"
        ],
        "properties": {
          "accountNumberOrEbn": {
            "type": "string",
            "description": "Your firm\u2019s account number at BofA Securities if you are an Institutional customer. If you are a broker/dealer, it will be your EBN symbol prefixed with \u201cEBN\u201d.\n\nIf you are a broker/dealer, your operations team will be able to provide you the EBN symbol to use. For (a possibly out of date) list, see <a href=\"https://www.dtcc.com/wealth-management-services/insurance-and-retirement-services/broker-identification-number\" target=\"_blank\" rel=\"noopener noreferrer\">DTCC</a>. Ex. Merrill Lynch, Pierce, Fenner & Smith Inc. has MLCO as the symbol and you would provide \u201cEBNMLCO\u201d in the request"
          },
          "confirmations": {
            "type": "array",
            "description": "Future use, empty array",
            "items": {
              "$ref": "#/components/schemas/TradeConfirmation"
            }
          },
          "cusip": {
            "type": "string",
            "description": "CUSIP with or without the 9th check digit"
          },
          "bidId": {
            "type": "number",
            "description": "Bid reference number for SELL. This identifies the specific bid response against which the trade is done"
          },
          "price": {
            "type": "number",
            "description": "Echo back of the price at which the buy or sell is happening. This ensures that the price expectation of the transaction is matched"
          },
          "quantity": {
            "type": "integer",
            "description": "Transaction quantity\n\nIn 1000s. If 50 bonds are required, 50000 should be specified. In words, that number is \u201cfifty thousand\u201d"
          },
          "stepOutIndicator": {
            "type": "boolean",
            "description": "Is BofA Securities stepping out of this trade\n\nTalk to your operations team for this type of trade, a custodian is usually involved to take possession of the securities"
          },
          "transactionType": {
            "type": "string",
            "description": "Side: BUY/SELL\n\nSide is from <u>your</u> perspective. You, the customer, are BUYing from or SELLing to BofA Securities"
          }
        }
      },
      "TradeConfirmation": {
        "type": "object",
        "description": "Future use",
        "example": {}
      },
      "response": {
        "type": "object",
        "properties": {
          "orderResponse": {
            "type": "array",
            "description": "Array of responses for each element of the orderResponse. The combination of CUSIP and quantity can be used as a correlate for the request element",
            "items": {
              "$ref": "#/components/schemas/responseDetails"
            }
          }
        },
        "description": "Successful response",
        "example": {
          "orderResponse": [
            {
              "cusip": "882275AA8",
              "settlementDate": "2020-04-20",
              "accountNumber": "19AZ1234",
              "referenceNumber": 0,
              "quantityDollarAmount": 100000,
              "transactionType": "BUY",
              "hasError": true,
              "errorMessage": "No offer found for cusip 882275AA8.",
              "errorType": null
            },
            {
              "cusip": "00037NJR8",
              "settlementDate": "2020-04-20",
              "accountNumber": "19AZ1234",
              "referenceNumber": 1938510,
              "quantityDollarAmount": 100000,
              "transactionType": "BUY",
              "hasError": false,
              "errorMessage": null,
              "errorType": null
            }
          ]
        }
      },
      "responseDetails": {
        "type": "object",
        "properties": {
          "cusip": {
            "type": "string",
            "description": "CUSIP with or without the 9th check digit"
          },
          "settlementDate": {
            "type": "string",
            "description": "Date when the transaction must settle on Expected format YYYY-MM-DD. All numbers."
          },
          "accountNumber": {
            "type": "string",
            "description": "Your firm\u2019s account number at BofA Securities if you are an Institutional customer"
          },
          "referenceNumber": {
            "type": "number",
            "description": "Your (BofA Securities generated) trade reference number"
          },
          "quantityDollarAmount": {
            "type": "integer",
            "description": "Transaction quantity in US dollars In 1000s. If 50 bonds are required, 50000 should be specified. In words, that number is \u201cfifty thousand\u201d."
          },
          "transactionType": {
            "type": "string",
            "description": "Side: BUY/SELL Side is from your perspective. You, the customer, are BUYing from or SELLing to BofA Securities"
          },
          "hasError": {
            "type": "boolean",
            "description": "If there were errors when processing the request True/False"
          },
          "errorMessage": {
            "type": "string",
            "description": "Messages if \u2018hasError\u2019 is True. While every effort will be made to notify and co-ordinate when these error message text change, BofA Securities reserves the right to change the text without notice. May\u00a0have\u00a0a\u00a0&#60;null&#62;\u00a0value"
          },
          "errorType": {
            "type": "string",
            "description": "Future use. May\u00a0have\u00a0a\u00a0&#60;null&#62;\u00a0value"
          }
        }
      },
