  "openapi": "3.0.1",
  "info": {
    "title": "Global Markets \u2013 Munibonds Trade",
    "description": "Allows a user to place a trade that is based on an offer or a previously submitted bid request which has a BofA response (\u201cBid Response\u201d).",
