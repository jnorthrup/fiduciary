        "properties": {
          "Value": {
            "type": "string",
            "description": "Amount max 12 digits to the left of the decimal max 2 digits to the right of the decimal for all currencies except JPY which does not have any decimals. Max:999999999999.99. Notes: The amount:value field can be a positive number for invoices and should be a negative number for credit memos."
          },
          "Type": {
            "type": "string",
            "description": "Invoice or Credit Memo. Notes: The amount:type field shall be \u201cInvoice\u201d for positive amount and \u201cCredit Memo\u201d for negative amounts.",
