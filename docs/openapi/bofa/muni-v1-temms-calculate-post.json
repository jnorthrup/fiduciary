  "components": {
    "schemas": {
      "calculateAPI": {
        "required": [
          "calculateRequest"
        ],
        "type": "object",
        "properties": {
          "calculateRequest": {
            "$ref": "#/components/schemas/calculateRequest"
          }
        },
        "example": {
          "calculateRequest": {
            "dateTo": "2017-10-04",
            "cusip": "613679AD1",
            "quantityDollarAmount": 100000
          }
        }
      },
      "calculateRequest": {
        "description": "Interest accrual calculation object.",
        "type": "object",
        "required": [
          "dateTo",
          "Cusip",
          "quantityDollarAmount"
        ],
        "properties": {
          "dateTo": {
            "type": "string",
            "description": "Date for the interest to be calculated to Expected format YYYY-MM-DD. All numbers."
          },
          "Cusip": {
            "type": "string",
            "description": "CUSIP with or without the 9th check digit"
          },
          "quantityDollarAmount": {
            "type": "integer",
            "description": "Face value of the bonds for interest accrual to be calculated against"
          }
        }
      },
      "accruedInterest": {
        "type": "object",
        "properties": {
          "fromDate": {
            "type": "string",
            "description": "Start date of the calculation period Expected format YYYY-MM-DD. All numbers. <br> May have a &#60;null&#62; value"
          },
          "toDate": {
            "type": "string",
            "description": "End date of the specific calculation period Expected format YYYY-MM-DD. All numbers.<br> May have a &#60;null&#62; value"
          },
          "accruedInterest": {
            "type": "number",
            "description": "Total Interest accrual accumulated through the calculation request"
          },
          "cusip": {
            "type": "string",
            "description": "CUSIP with or without the 9th check digit"
          },
          "issuerDescription": {
            "type": "string",
            "description": "Detailed text description of the issuer"
          },
          "rateHistoryDetails": {
            "type": "array",
            "description": "Array of rate of \u201cn\u201d calculation periods",
            "items": {
              "$ref": "#/components/schemas/rateHistoryDetail"
            }
          }
        },
        "example": {
          "accruedInterest": {
            "fromDate": null,
            "toDate": null,
            "accruedInterest": 7.86,
            "rateHistoryDetails": [
              {
                "rate": 1.02,
                "accruedInterest": 2.795,
                "accruedInterestTotal": 2.795,
                "effectiveFromDate": "2017-10-01",
                "effectiveToDate": "2017-10-01"
              },
              {
                "rate": 0.94,
                "accruedInterest": 2.575,
                "accruedInterestTotal": 5.37,
                "effectiveFromDate": "2017-10-02",
                "effectiveToDate": "2017-10-02"
              },
              {
                "rate": 0.91,
                "accruedInterest": 2.493,
                "accruedInterestTotal": 7.863,
                "effectiveFromDate": "2017-10-03",
                "effectiveToDate": "2017-10-03"
              }
            ],
            "cusip": "613679AD1",
            "issuerDescription": "Montgomery Cnty Public Bldg Pooled Loan 2002"
          }
        }
      },
      "rateHistoryDetail": {
        "type": "object",
        "properties": {
          "rate": {
            "type": "number",
            "description": "Interest rate applied to the specific \u201cfrom\u201d and \u201cto\u201d period"
          },
          "accruedInterest": {
            "type": "number",
            "description": "Interest accrual calculated in the specific \u201cfrom\u201d and \u201cto\u201d period"
          },
          "accruedInterestTotal": {
            "type": "number",
            "description": "Total Interest accrual accumulated through the calculation request until the end of the \u201cto\u201d date"
          },
          "effectiveFromDate": {
            "type": "string",
            "description": "Start date of the specific calculation period <br>Expected format YYYY-MM-DD. All numbers"
          },
          "effectiveToDate": {
            "type": "string",
            "description": "End date of the specific calculation period <br>Expected format YYYY-MM-DD. All numbers."
          }
        }
      },
