  "components": {
    "schemas": {
      "temmsSavedSearchUpdateRequest": {
        "type": "object",
        "required": [
          "addSavedSearch",
          "updateSavedSearch",
          "deleteSavedSearch"
        ],
        "properties": {
          "addSavedSearch": {
            "type": "array",
            "description": "Array of saved search to be added. All fields, values, operand and name correspond exactly to the Offer API (\u201cmuni/v1/temms/offer\u201c)",
            "items": {
              "$ref": "#/components/schemas/temmsSavedSearch"
            }
          },
          "updateSavedSearch": {
            "type": "array",
            "description": "Array of saved searches to be updated. Structure is the same as addSavedSearch",
            "items": {
              "$ref": "#/components/schemas/temmsSavedSearch"
            }
          },
          "deleteSavedSearch": {
            "type": "array",
            "description": "string Array of saved search names to be deleted",
            "items": {
              "type": "string"
            }
          }
        },
        "example": {
          "addSavedSearch": [
            {
              "criteria": [
                {
                  "field": "coupon",
                  "operand": "<=",
                  "value": "2"
                }
              ],
              "name": "Coupon1",
              "notification": true
            }
          ],
          "updateSavedSearch": [
            {
              "criteria": [
                {
                  "field": "coupon",
                  "operand": "<=",
                  "value": "1"
                }
              ],
              "name": "1cpn",
              "notification": true
            }
          ],
          "deleteSavedSearch": [
            "5cpn"
          ]
        }
      },
      "temmsSavedSearch": {
        "type": "object",
        "properties": {
          "criteria": {
            "type": "array",
            "description": "Criteria of saved search",
            "items": {
              "$ref": "#/components/schemas/criteriaTemmsSavedSearch"
            }
          },
          "name": {
            "type": "string",
            "description": "Name of saved search"
          },
          "notification": {
            "type": "boolean",
            "description": "Set true if user needs any offer updates notification matching with saved search criteria. The Email address on file with BofA Securities Mercury&#153; will receive an email when inventory matches this saved search"
          }
        }
      },
      "criteriaTemmsSavedSearch": {
        "type": "object",
        "properties": {
          "field": {
            "type": "string",
            "description": "Field represent different offer criteria properties. Refer to Offer API for fields"
          },
          "value": {
            "type": "string",
            "description": "Value set for criteria field"
          },
          "operand": {
            "type": "string",
            "description": "Valid operand corresponding to field. Refer to Offer API for operands"
          }
        }
      },
