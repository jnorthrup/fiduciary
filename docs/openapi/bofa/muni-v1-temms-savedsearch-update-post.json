  "paths": {
    "/muni/v1/temms/savedsearch/update": {
      "post": {
        "tags": [
          "Global Markets - Muni Services"
        ],
        "summary": "APIs that allow BofA Securities customers of Municipal Banking and Markets to transact Municipal securities. This API provides the customer the ability to update saved searches",
