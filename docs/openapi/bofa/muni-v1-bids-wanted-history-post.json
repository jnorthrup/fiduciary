      "searchResponseObject": {
        "type": "object",
        "properties": {
          "quoteId": {
            "type": "integer",
            "format": "Whole Number",
            "description": "Unique reference number for the bid answer",
            "example": 989890
          },
          "bidsWantedId": {
            "type": "integer",
            "format": "Whole Number",
            "description": "Original Bid request number",
            "example": 2312
          },
          "status": {
            "type": "string",
            "description": "Workflow status of the bid response.<br> 'Submitted', 'Answered', 'Pending', or 'Executed'"
          },
          "cusip": {
            "type": "string",
            "description": "CUSIP with or without the 9th check digit"
          },
          "accountNumberOrEbn": {
            "type": "string",
            "description": "Your firm\u2019s account number at BofA Securities if you are an Institutional customer. If you are a broker/dealer, it will be your EBN symbol prefixed with \u201cEBN\u201d.<br>If you are a broker/dealer, your operations team will be able to provide you the EBN symbol to use. For (a possibly out of date) list, see DTCC. Ex. Merrill Lynch, Pierce, Fenner & Smith Inc. has MLCO as the symbol and you would provide \u201cEBNMLCO\u201d in the request.<br>Only the \u201c=\u201d operand supported."
          },
