      "bidWantedHistoryRequest": {
        "required": [
          "searchRequest"
        ],
        "type": "object",
        "properties": {
          "searchRequestObject": {
            "$ref": "#/components/schemas/searchRequestObject"
          }
        },
        "description": "",
        "example": {
          "searchRequest": {
            "criteria": [
              {
                "field": "cusip",
                "operand": "=",
                "value": "64985TAG6"
              },
              {
                "field": "accountNumberOrEbn",
                "operand": "=",
                "value": "89A06078"
              },
              {
                "field": "quoteIdFrom",
                "operand": ">=",
                "value": "123123"
              },
              {
                "field": "quoteIdTo",
                "operand": "<=",
                "value": "123123"
              },
              {
                "field": "status",
                "operand": "=",
                "value": "Submitted"
              },
              {
                "field": "bidsWantedIdFrom",
                "operand": ">=",
                "value": 12121
              },
              {
                "field": "bidsWantedIdTo",
                "operand": "<=",
                "value": 12121
              }
            ]
          }
        }
      },
      "searchRequestObject": {
        "type": "object",
        "properties": {
          "criteria": {
            "type": "array",
            "description": "Array of bid search criteria",
            "items": {
              "$ref": "#/components/schemas/criteriaObject"
            }
          }
        },
        "description": "Bid search request"
      },
      "criteriaObject": {
        "type": "object",
        "properties": {
          "field": {
            "type": "string",
            "description": "Field represents different criteria properties.<br><br>'field': 'cusip'<br>'description': CUSIP with or without the 9th check digit. <br>'type': 'string'<br>'additional': Only the \u201c=\u201d operand supported. <br><br>'field': 'accountNumberOrEbn' <br>'description': Your firm\u2019s account number at BofA Securities if you are an Institutional customer. If you are a broker/dealer, it will be your EBN symbol prefixed with \u201cEBN\u201d.<br>'type': 'string'<br>'additional': If you are a broker/dealer, your operations team will be able to provide you the EBN symbol to use. For (a possibly out of date) list, see DTCC. Ex. Merrill Lynch, Pierce, Fenner & Smith Inc. has MLCO as the symbol and you would provide \u201cEBNMLCO\u201d in the request.<br>Only the \u201c=\u201d operand supported. <br><br>'field': 'quoteIdFrom'<br>'description': Quote Id range. <br>'type': 'Whole Number'<br>'additional': Operand \u201c>=\u201d supported. <br><br>'field': 'quoteIdTo'<br>'description': Quote Id range. <br>'type': 'Whole Number'<br>'additional': Operand \u201c<=\u201d supported. <br><br>'field': 'status'<br>'description': Workflow status of the bid. \nCan have one of the following values: \n\u201cSubmitted\u201d, \u201cExpired\u201d, \u201cCancelled\u201d, \u201cDenied\u201d, \u201cExecuted\u201d.<br>'type': 'string'<br>'additional': Only the \u201c=\u201d operand supported. It can be a comma separated list .<br><br>'field': 'bidsWantedIdFrom'<br>'description': Bids Wanted Id number range. <br>'type': 'Whole Number'<br>'additional': Operand \u201c>=\u201d supported in From <br><br>'field': 'bidsWantedIdTo'<br>'description': Bids Wanted Id number range. <br>'type': 'Whole Number'<br>'additional': Operand \u201c<=\u201d supported in To."
          },
          "operand": {
            "type": "string",
            "description": "Valid operand corresponding to field"
          },
          "value": {
            "type": "string",
            "description": "Value set for criteria field"
          }
        }
      },
      "ResponseBody": {
        "type": "object",
        "properties": {
          "searchResponse": {
            "type": "array",
            "description": "",
            "items": {
              "$ref": "#/components/schemas/searchResponseObject"
            }
          }
        },
        "description": "",
        "example": {
          "searchResponse": [
            {
              "quoteId": 989890,
              "bidsWantedId": 98989,
              "status": "Submitted",
              "cusip": "007266KS7",
              "accountNumberOrEbn": "89A30051",
              "quantity": 50000,
              "price": 113.419,
              "priceType": "Price/Yield",
              "expirationTime": "2024-07-24T05:07:49.193-04:00",
              "timestamp": "2024-07-24T05:07:49.193-04:00",
              "hasError": false,
              "errorMessage": null,
              "errorType": null,
