            "type": "string",
            "format": "DateTime",
            "description": "Expiration time for the customer price"
          },
          "timestamp": {
            "type": "string",
            "format": "DateTime",
            "description": "Bid answered time"
          },
          "hasError": {
            "type": "boolean",
            "description": "If there were errors when processing the request"
          },
          "errorMessage": {
            "type": "string",
            "description": "Populated with error message if hasError is true"
