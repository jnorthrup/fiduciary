            "type": "object",
            "description": "Response Object containing the result of the Verification of Payee",
            "allOf": [
              {
                "$ref": "#/components/schemas/Response"
              }
            ]
          }
        },
        "example": {
          "requestId": "P61e214f-3305-481c-9a79-7e9e41760S2B",
          "validatedDateTime": "2025-08-05T14:06:45.524Z",
          "endToEndId": "44ce1a1e-3728-2d1c-a9af-b3a1Test44",
          "originalRequest": {
            "verificationScheme": "SEPAVOP",
            "account": {
              "identification": "IE47EBSI93902145720398"
            },
            "accountAgent": {
              "country": "IE"
            },
            "accountOwner": {
              "name": {
                "fullName": "SACHA JANICKOVICOVA"
              }
            }
          },
          "response": {
            "match": "Y",
            "reason": [
              {
                "code": "00",
                "serviceProviderCode": "MTCH",
                "description": "Exact Match. The beneficiary information provided is an exact match."
              }
            ]
          }
        }
      },
