            "type": "string",
            "description": "Match Status to indicate if the Full Name supplied by the customer has Completely, Partially or Not Matched with the Owner details associated with the Credit Account.<br>Enum<br>Y - Matched<br>N - Not Matched<br>C - Close Match<br>P - Partial Match<br>U - Match could not be performed",
            "enum": [
              "Y",
              "N",
              "C",
              "P",
              "U"
            ]
          },
          "verifiedAccountOwner": {
            "type": "object",
