  "components": {
    "schemas": {
      "requestBody": {
        "type": "object",
        "required": [
          "endToEndId",
          "account",
          "accountOwner"
        ],
        "properties": {
          "endToEndId": {
            "type": "string",
            "description": "Co-relation id for the call back.<br>Length 1 - 36",
            "minLength": 1,
            "maxLength": 36
          },
          "account": {
            "type": "object",
            "description": "Details about the Account that needs to be validated.",
            "allOf": [
              {
                "$ref": "#/components/schemas/account"
              }
            ]
          },
          "accountAgent": {
            "type": "object",
            "description": "The Financial Institution holding the credit account.",
            "allOf": [
              {
                "$ref": "#/components/schemas/accountAgent"
              }
            ]
          },
          "accountOwner": {
            "type": "object",
            "description": "Details about owner of the account.",
            "allOf": [
              {
                "$ref": "#/components/schemas/accountOwner"
              }
            ]
          }
        },
        "example": {
          "endToEndId": "44ce1a1e-3728-2d1c-a9af-b3a1Test44",
          "account": {
            "identification": "IE47EBSI93902145720398"
          },
          "accountAgent": {
            "country": "IE"
          },
          "accountOwner": {
            "name": {
              "fullName": "SACHA JANICKOVICOVA"
            }
          }
        }
      },
      "account": {
        "required": [
          "identification"
        ],
        "type": "object",
        "properties": {
          "identification": {
            "type": "string",
            "description": "Account number.<br>Length : 15 \u2013 35<br>User will be supplying the Party IBAN here which is mandatory for SEPA VOP",
            "minLength": 15,
            "maxLength": 35
          }
        }
      },
      "accountAgent": {
        "required": [
          "country"
        ],
        "type": "object",
        "properties": {
          "country": {
            "type": "string",
            "description": "Bank Resident country. 2 digit ISO Country Code.<br>SEPA Country List : \"AD\", \"AT\", \"AX\", \"BE\", \"BG\", \"CH\", \"CZ\", \"CY\",\"DE\", \"DK\", \"EE\", \"ES\", \"FI\", \"FR\", \"GI\", \"GR\", \"GF\", \"GP\", \"HR\", \"HU\", \"IE\", \"IS\", \"IT\", \"LT\", \"LV\", \"NL\",\"NO\", \"PL\", \"PT\", \"RO\", \"SE\", \"SK\", \"LU\", \"MT\", \"SI\", \"MC\", \"MF\", \"MQ\", \"YT\", \"RE\", \"LI\", \"BL\", \"PM\", \"VA\",\"SM\", \"ME\", \"AL\", \"MD\", \"MK\"<br>Account Agent Country will be used to determine the Scheme against which verification will be performed. For SEPA list of countries are mentioned as above"
          }
        }
      },
      "accountOwner": {
        "required": [
          "name"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "object",
            "description": "Name of the party",
            "allOf": [
              {
                "$ref": "#/components/schemas/name"
              }
            ]
          }
        }
      },
      "name": {
        "required": [
          "fullName"
        ],
        "type": "object",
        "properties": {
          "fullName": {
            "type": "string",
            "description": "Full Name of the Party"
          }
        }
      },
      "response": {
        "required": [
          ""
        ],
        "type": "object",
        "properties": {
          "endToEndId": {
            "type": "string",
            "description": "Co-relation id for the call back.<br> Length 1 - 36",
            "minLength": 1,
            "maxLength": 36
          },
          "requestId": {
            "type": "string",
            "description": "Context id from application for reference.<br> Length 36 UUID",
            "maxLength": 36
          },
          "validatedDateTime": {
            "type": "string",
            "description": "Date and time stamp when the Verification of payee was performed"
          },
          "originalRequest": {
            "type": "object",
            "description": "Original details supplied in the request",
            "allOf": [
