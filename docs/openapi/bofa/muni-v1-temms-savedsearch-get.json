  "components": {
    "schemas": {
      "temmsSavedSearchesResponse": {
        "type": "object",
        "properties": {
          "savedSearches": {
            "type": "array",
            "description": "Array of objects containing the searches the user has created. All fields, values, operand and name correspond exactly to the Offer API (\u201cmuni/v1/temms/offer\u201c)",
            "items": {
              "$ref": "#/components/schemas/temmsSavedSearch"
            }
          }
        },
        "example": {
          "savedSearches": [
            {
              "criteria": [
                {
                  "field": "cusip",
                  "operand": "=",
                  "value": "1XMD65123"
                },
                {
                  "field": "resetMode",
                  "operand": "=",
                  "value": "DAILY"
                }
              ],
              "name": "search1",
              "notification": false
            },
            {
              "criteria": [
                {
                  "field": "cusip",
                  "operand": "=",
                  "value": "ABMD65123"
                },
                {
                  "field": "resetMode",
                  "operand": "=",
                  "value": "WEEKLY"
                }
              ],
              "name": "search2",
              "notification": false
            }
          ]
        }
      },
      "temmsSavedSearch": {
        "type": "object",
        "properties": {
          "criteria": {
            "type": "array",
            "description": "Criteria of saved search",
            "items": {
              "$ref": "#/components/schemas/criteriaTemmsSavedSearch"
            }
          },
          "name": {
            "type": "string",
            "description": "Name of saved search"
          },
          "notification": {
            "type": "boolean",
            "description": "Set true if user needs any offer updates notification matching with saved search criteria. The Email address on file with BofA Securities Mercury \u2122; will receive an email when inventory matches this saved search"
          }
        }
      },
      "criteriaTemmsSavedSearch": {
        "type": "object",
        "properties": {
          "field": {
            "type": "string",
            "description": "Field represent different offer criteria properties. Refer to Offer API for fields"
          },
          "value": {
            "type": "string",
            "description": "Value set for criteria field"
          },
          "operand": {
            "type": "string",
            "description": "Valid operand corresponding to field. Refer to Offer API for operands"
          }
        }
      },
