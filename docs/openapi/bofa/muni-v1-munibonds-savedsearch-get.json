        "type": "object",
        "properties": {
          "criteria": {
            "type": "array",
            "description": "Criteria of saved search",
            "items": {
              "$ref": "#/components/schemas/CriteriaArray"
            }
          },
          "name": {
            "type": "string",
            "description": "Name of saved search",
            "example": "Coupon1"
          },
          "notification": {
            "type": "boolean",
            "description": "Set true if user needs any offer updates notification matching with saved search criteria. The Email address on file with BofA Securities Mercury\u2122 will receive an email when inventory matches this saved search",
            "example": true
          }
        }
      },
      "CriteriaArray": {
        "type": "object",
        "properties": {
          "field": {
            "type": "string",
            "description": "Field represent different offer criteria properties",
            "example": "coupon"
          },
          "operand": {
            "type": "string",
            "description": "Valid operand corresponding to field",
            "example": "<="
          },
          "value": {
            "type": "string",
            "description": "Value set for criteria field",
            "example": "2"
          }
        }
