            }
          }
        },
        "example": {
          "savedSearches": [
            {
              "criteria": [
                {
                  "field": "coupon",
                  "operand": "<=",
                  "value": "1"
                }
              ],
              "name": "1cpn",
              "notification": true
            },
            {
              "criteria": [
                {
                  "field": "coupon",
                  "operand": "<=",
                  "value": "2"
                }
              ],
              "name": "Coupon1",
              "notification": true
