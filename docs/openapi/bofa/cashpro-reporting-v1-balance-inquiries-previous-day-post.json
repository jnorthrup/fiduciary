            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "BalanceResponse": {
        "required": [
          "accountBalances"
        ],
        "type": "object",
        "properties": {
          "accountBalances": {
            "$ref": "#/components/schemas/account"
          }
        }
      },
      "account": {
        "required": [
          "accountNumber"
        ],
        "type": "object",
        "description": "Accounts returned with balance details.",
        "properties": {
          "accountNumber": {
            "type": "string",
            "description": "Account number. Length : 1 - 35",
            "example": "600811111111"
          },
          "bankId": {
            "type": "string",
            "description": "BIC or routing number of the account. Length : 1 - 12",
            "example": "BOFAGB22"
          },
          "currency": {
            "type": "string",
            "description": "Currency code of the account, as documented by ISO 4217 Codes for the representation of currencies and funds.",
            "example": "EUR"
          },
          "balances": {
            "type": "array",
            "description": "Balance details returned",
            "items": {
              "$ref": "#/components/schemas/balances"
            }
          }
        }
      },
      "balanceAPI": {
        "required": [
          "balanceAsOfDate"
        ],
        "type": "object",
        "properties": {
          "balanceAsOfDate": {
            "type": "string",
            "description": "Date of requested balances in YYYY-MM-DD format.",
            "example": "2017-07-04"
          },
          "accounts": {
            "type": "array",
            "description": "Accounts requested",
            "items": {
              "$ref": "#/components/schemas/accounts"
            }
          }
        }
      },
      "balances": {
        "required": [
          "transactionDescription"
        ],
        "type": "object",
        "properties": {
          "transactionDescription": {
            "type": "string",
            "description": "A description of the BAI code balance being reported. Ex: Opening Ledger Balance, Closing Ledger Balance, Opening Available Balance, Collected/Closing Available Balance.",
            "example": "Opening Ledger Balance"
          },
          "transactionCode": {
            "type": "string",
            "description": "BAI code of the balance amount reported. </br> Ex: 010, 015, 040, 045",
            "example": "010"
          },
          "amount": {
            "type": "string",
            "description": "Balance amount represented as 999999999999999999.99 Length: 1-21",
            "example": "983.97"
          },
          "lastUpdatedDate": {
            "type": "string",
            "description": "Date of the balance reported in YYYY-MM-DD format, which may be different than the requested balance if weekend or not working day was requested.",
            "example": "2017-07-04"
          }
        }
      },
      "accounts": {
        "required": [
          "accountNumber"
        ],
        "type": "object",
        "properties": {
          "accountNumber": {
            "type": "string",
            "description": "Account number. Length : 1 - 35",
            "example": "601022222222"
          },
          "bankId": {
            "type": "string",
            "description": "BIC or routing number of the account. Length : 1 - 12",
            "example": "BOFAFRPP"
          }
        }
      },
      "reason": {
        "type": "object",
        "properties": {
          "reasonCode": {
            "type": "integer"
          },
          "reasonDescription": {
            "type": "string"
          }
        }
      },
