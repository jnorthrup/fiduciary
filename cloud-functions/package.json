{
  "name": "ledger-pwa-cloud-functions",
  "version": "1.0.0",
  "description": "Cloud Functions for Ledger PWA orchestration and rollback",
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "test": "vitest"
  },
  "keywords": [
    "firebase",
    "cloud-functions",
    "orchestration",
    "rollback"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@google-cloud/firestore": "^7.10.0",
    "@google-cloud/pubsub": "^4.9.0",
    "@kubernetes/client-node": "^0.21.0",
    "firebase-admin": "^12.7.0",
    "firebase-functions": "^6.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": "22"
  },
  "private": true
}
