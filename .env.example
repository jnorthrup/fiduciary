# Server-side IRIS credentials (never commit real keys)
IRIS_CLIENT_ID=your-client-id
IRIS_USER_ID=your-user-id
IRIS_TCC=DT1234
IRIS_KEY_ID=your-key-id
# Multi-line PEM -> replace newlines with \n or use dotenv's multiline support
IRIS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEv...\n-----END PRIVATE KEY-----"
IRIS_TEST_MODE=1
# Local protection: set an API key to require "x-api-key" header
IRIS_API_KEY=devkey
# For development only: set MOCK mode to avoid real network calls
IRIS_MOCK_MODE=1
