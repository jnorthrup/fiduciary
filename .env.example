# Server-side IRIS credentials (never commit real keys)
IRIS_CLIENT_ID=your-client-id
IRIS_USER_ID=your-user-id
IRIS_TCC=DT1234
IRIS_KEY_ID=your-key-id
# Multi-line PEM -> replace newlines with \n or use dotenv's multiline support
IRIS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEv...\n-----END PRIVATE KEY-----"
IRIS_TEST_MODE=1
# Local protection: set an API key to require "x-api-key" header
IRIS_API_KEY=devkey
# For development only: set MOCK mode to avoid real network calls
IRIS_MOCK_MODE=1

# Gmail OAuth Configuration
# Get your client ID from: https://console.cloud.google.com/apis/credentials
VITE_GMAIL_CLIENT_ID=your-gmail-oauth-client-id.apps.googleusercontent.com

# AI Configuration (Gemini API)
VITE_GEMINI_API_KEY=your-gemini-api-key

# Plaid Bank API Configuration
VITE_PLAID_ENV=sandbox
VITE_PLAID_CLIENT_ID=your-plaid-client-id
VITE_PLAID_SECRET=your-plaid-secret

# Demo mode (set to true in development only)
VITE_DEMO_MODE=true

# Firebase Configuration (optional, for auth)
VITE_FIREBASE_ENABLED=false
VITE_FIREBASE_CONFIG={}
VITE_GMAIL_AUTH_ENABLED=false

# BOFA CashPro Configuration
# GCP Project ID (required for Secret Manager access to BOFA credentials)
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# BOFA OAuth token endpoint (sandbox environment)
BOFA_TOKEN_URL=https://api.bankofamerica.com/auth/oauth/v2/token
# Egress IP range for GCP Cloud NAT (BOFA requires static IP whitelisting)
# Range: 35.190.0.0/18 (Google Cloud us-central1 region)
BOFA_EGRESS_IP_RANGE=35.190.0.0/18
