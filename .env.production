# Production environment for GCS static hosting
# Firebase/Gmail auth DISABLED for public static hosting
VITE_FIREBASE_ENABLED=false
VITE_GMAIL_AUTH_ENABLED=false

# IRIS API Configuration (use backend API server)
VITE_IRS_API_URL=/api
VITE_IRS_MOCK_MODE=false

# Feature flags
VITE_ENABLE_GMAIL_OAUTH=false
VITE_ENABLE_FIREBASE_AUTH=false

# AI Configuration (Gemini API)
VITE_GEMINI_API_KEY=

# Plaid Bank API Configuration
VITE_PLAID_ENV=sandbox
VITE_PLAID_CLIENT_ID=
VITE_PLAID_SECRET=

# Demo mode (set to true in development only)
VITE_DEMO_MODE=false
