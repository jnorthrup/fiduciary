# FoundationDB Service for external access
apiVersion: v1
kind: Service
metadata:
  name: foundationdb-external
  namespace: ${namespace}
  annotations:
    cloud.google.com/neg: '{"exposed_ports": {"4500":{"name":"fdb-4500"}}}'
spec:
  type: ClusterIP
  ports:
  - port: 4500
    name: fdb
    targetPort: 4500
  selector:
    app: foundationdb

---
# HorizontalPodAutoscaler for storage nodes
apiVersion: autoscaling/v2
kind: HorizontalPodAutoscaler
metadata:
  name: foundationdb-storage-hpa
  namespace: ${namespace}
spec:
  scaleTargetRef:
    apiVersion: apps/v1
    kind: StatefulSet
    name: foundationdb-storage
  minReplicas: 3
  maxReplicas: 10
  metrics:
  - type: Resource
    resource:
      name: cpu
      target:
        type: Utilization
        averageUtilization: 70
  - type: Resource
    resource:
      name: memory
      target:
        type: Utilization
        averageUtilization: 80

---
# PodDisruptionBudget for coordinators
apiVersion: policy/v1
kind: PodDisruptionBudget
metadata:
  name: foundationdb-coordinator-pdb
  namespace: ${namespace}
spec:
  minAvailable: 2
  selector:
    matchLabels:
      app: foundationdb
      tier: coordinator

---
# PodDisruptionBudget for storage
apiVersion: policy/v1
kind: PodDisruptionBudget
metadata:
  name: foundationdb-storage-pdb
  namespace: ${namespace}
spec:
  minAvailable: 2
  selector:
    matchLabels:
      app: foundationdb
      tier: storage
