# FoundationDB StatefulSet for GKE Autopilot
# Scale-to-zero compatible FoundationDB deployment

apiVersion: v1
kind: ConfigMap
metadata:
  name: fdb-config
  namespace: ${namespace}
data:
  # FoundationDB cluster file
  cluster-file: |
    ${description:A FoundationDB cluster description file}
    ${coordinates:}
    ${version:}
    ${database:}
    ${initialKeys:}
    ${keyServers:}

  # FDB monitor configuration
  fdbmonitor-conf: |
    [general]
    restart_on_failure = true
    kill_on_configuration_change = false

    [fdbserver]
    command = $BINARY_DIR/fdbserver
    public_address = $$FDB_PUBLIC_IP:$$FDB_PORT
    class = $$FDB_CLASS
    memory = $$FDB_MEMORY
    disk = $DATA_DIR
    logdir = $LOG_DIR
    localhost = $FDB_LOCAL_IP
    listen_on_public = 1

    [fdbstorage]
    # Storage engine configuration

    [backup]
    # Backup configuration

---
apiVersion: v1
kind: Service
metadata:
  name: foundationdb
  namespace: ${namespace}
  labels:
    app: foundationdb
spec:
  ports:
  - port: 4500
    name: fdb
    targetPort: 4500
  - port: 4501
    name: fdb-tls
    targetPort: 4501
  clusterIP: None
  selector:
    app: foundationdb

---
apiVersion: v1
kind: Service
metadata:
  name: foundationdb-coordinator
  namespace: ${namespace}
  labels:
    app: foundationdb
spec:
  ports:
  - port: 4500
    name: fdb
  selector:
    app: foundationdb
    tier: coordinator

---
apiVersion: apps/v1
kind: StatefulSet
metadata:
  name: foundationdb
  namespace: ${namespace}
spec:
  serviceName: foundationdb
  replicas: ${coordinator_count}
  podManagementPolicy: Parallel
  selector:
    matchLabels:
      app: foundationdb
  template:
    metadata:
      labels:
        app: foundationdb
        tier: coordinator
    spec:
      terminationGracePeriodSeconds: 1800
      serviceAccountName: foundationdb
      containers:
      - name: foundationdb
        image: foundationdb/foundationdb-k8s:${fdb_version}
        ports:
        - containerPort: 4500
          name: fdb
        - containerPort: 4501
          name: fdb-tls
        env:
        - name: FDB_PUBLIC_IP
          valueFrom:
            fieldRef:
              fieldPath: status.podIP
        - name: FDB_LOCAL_IP
          value: "127.0.0.1"
        - name: FDB_PORT
          value: "4500"
        - name: FDB_MEMORY
          value: "2Gi"
        - name: FDB_CLASS
          value: "storage"
        - name: FDB_COORDINATOR
          value: "true"
        - name: DATA_DIR
          value: "/var/fdb/data"
        - name: LOG_DIR
          value: "/var/fdb/logs"
        volumeMounts:
        - name: data
          mountPath: /var/fdb/data
        - name: logs
          mountPath: /var/fdb/logs
        - name: config
          mountPath: /var/fdb/config
        readinessProbe:
          exec:
            command:
            - /usr/bin/fdbcli
            - -C
            - $(FDB_PUBLIC_IP):4500
            - --exec
            - "status; exit_on_error 1"
          initialDelaySeconds: 10
          periodSeconds: 10
        livenessProbe:
          exec:
            command:
            - /usr/bin/fdbcli
            - -C
            - $(FDB_PUBLIC_IP):4500
            - --exec
            - "status; exit_on_error 1"
          initialDelaySeconds: 30
          periodSeconds: 30
        resources:
          requests:
            cpu: "100m"
            memory: "2Gi"
          limits:
            cpu: "2000m"
            memory: "4Gi"
      volumes:
      - name: config
        configMap:
          name: fdb-config
  volumeClaimTemplates:
  - metadata:
      name: data
    spec:
      accessModes: [ "ReadWriteOnce" ]
      storageClassName: ${storage_class}
      resources:
        requests:
          storage: ${storage_size}
  - metadata:
      name: logs
    spec:
      accessModes: [ "ReadWriteOnce" ]
      storageClassName: ${storage_class}
      resources:
        requests:
          storage: "10Gi"

---
# FoundationDB storage processes (Autoscaling)
apiVersion: apps/v1
kind: StatefulSet
metadata:
  name: foundationdb-storage
  namespace: ${namespace}
spec:
  serviceName: foundationdb
  replicas: 3
  podManagementPolicy: Parallel
  selector:
    matchLabels:
      app: foundationdb
      tier: storage
  template:
    metadata:
      labels:
        app: foundationdb
        tier: storage
    spec:
      serviceAccountName: foundationdb
      containers:
      - name: foundationdb
        image: foundationdb/foundationdb-k8s:${fdb_version}
        ports:
        - containerPort: 4500
          name: fdb
        env:
        - name: FDB_PUBLIC_IP
          valueFrom:
            fieldRef:
              fieldPath: status.podIP
        - name: FDB_LOCAL_IP
          value: "127.0.0.1"
        - name: FDB_PORT
          value: "4500"
        - name: FDB_MEMORY
          value: "4Gi"
        - name: FDB_CLASS
          value: "storage"
        - name: FDB_COORDINATOR
          value: "false"
        - name: DATA_DIR
          value: "/var/fdb/data"
        - name: LOG_DIR
          value: "/var/fdb/logs"
        volumeMounts:
        - name: data
          mountPath: /var/fdb/data
        - name: logs
          mountPath: /var/fdb/logs
        resources:
          requests:
            cpu: "200m"
            memory: "4Gi"
          limits:
            cpu: "4000m"
            memory: "8Gi"
  volumeClaimTemplates:
  - metadata:
      name: data
    spec:
      accessModes: [ "ReadWriteOnce" ]
      storageClassName: ${storage_class}
      resources:
        requests:
          storage: ${storage_size}
  - metadata:
      name: logs
    spec:
      accessModes: [ "ReadWriteOnce" ]
      storageClassName: ${storage_class}
      resources:
        requests:
          storage: "10Gi"

---
# ServiceAccount for FoundationDB
apiVersion: v1
kind: ServiceAccount
metadata:
  name: foundationdb
  namespace: ${namespace}
  annotations:
    iam.gke.io/gcp-service-account: ${service_account_email}
